# /etc/exir/host-watch.env  (root:root, chmod 600)  - copy from host-watch.env.example, fill in on the SERVER only.
# The token must equal INTERNAL_ALERT_TOKEN in the app's .env (>= 32 random chars: `openssl rand -hex 32`).
INTERNAL_ALERT_TOKEN=__SET_ON_SERVER_NEVER_COMMIT__

# How host-watch reaches the backend. Pick ONE:
# (a) backend published on loopback only (compose BACKEND_BIND=127.0.0.1):
#ALERT_URL=http://127.0.0.1:3001/api/internal/alert
# (b) look up the backend container's docker-network IP each run (default compose setup; no published port):
BACKEND_CONTAINER=exir-erp-backend-1
BACKEND_PORT=3001

#STATE_DIR=/var/lib/exir-host-watch
#SSH_ALLOWLIST=/etc/exir/known-ssh.allow
#NGINX_ACCESS_LOG=/var/log/nginx/access.log
#NGINX_5XX_MIN=20
#NGINX_5XX_RATIO=10
#FAIL2BAN_SPIKE=25
#DISK_WARN_PCT=85
#DISK_PATHS="/ /var/lib/docker"
# names (docker ps) that must be running; empty = skip
#EXPECTED_CONTAINERS="exir-erp-backend-1 exir-erp-postgres-1 exir-erp-web-1"
CERT_HOSTS=app.example.ir,admin.example.ir
#CERT_WARN_DAYS=14
#REBOOT_PENDING_DAYS=7
#FAILED_UNITS_IGNORE='^(apt-daily|fwupd)'
