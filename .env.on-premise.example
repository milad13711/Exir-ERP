# Copy this file to .env next to docker-compose.on-premise.yml and fill in
# every value below before running `docker compose -f docker-compose.on-premise.yml up -d --build`.
# See docs/ON_PREMISE.md for the full walkthrough.

# A strong password for the local Postgres instance this bundle runs for you.
POSTGRES_PASSWORD=

# A long random secret used to sign login sessions. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# Given to you by Exir when your license was issued — paste them exactly as
# received, including the literal \n sequences in the public key.
LICENSE_KEY=
LICENSE_PUBLIC_KEY_PEM=

# Optional: lets this deployment check in with Exir's cloud periodically to
# catch a license revocation early, IF this server has outbound internet
# access. Leave empty for a fully air-gapped/offline deployment — the
# license still enforces its own expiry completely offline either way.
CONTROL_PLANE_CHECKIN_URL=

# Your organization and the first account (becomes "مدیر سیستم" — full
# access) that can log in once the deployment is up.
ON_PREM_ORG_NAME=
ON_PREM_ORG_SLUG=local
ON_PREM_OWNER_NAME=
ON_PREM_OWNER_PHONE=

# The single port exposed on this server (nginx reverse-proxies both the
# web panel and the API behind it). Change if 80 is already taken.
EXPOSED_PORT=80

# اکسیر پیامک (exirsms.ir) — واقعی کردن ارسال پیامک کد ورود. خالی بماند تا
# کد ورود در پاسخ API نمایش داده شود (فقط برای تست).
EXIR_SMS_API_KEY=
EXIR_SMS_SENDER_LINE=

# baha24.com — به‌روزرسانی خودکار نرخ ارز (بازار آزاد). خالی بماند تا این
# قابلیت غیرفعال بماند و کاربران نرخ ارز را دستی وارد کنند (رفتار پیش‌فرض).
BAHA24_API_KEY=

# Web Push برای پنل ادمین (اعلان چت زنده روی گوشی کارشناسان پشتیبانی).
# با اجرای این دستور یک‌بار تولید کن و همین‌جا کپی کن — خالی بماند تا این
# قابلیت غیرفعال بماند:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# کنسول داخلی تیم اکسیر (تننت‌ها/اشتراک‌ها) — فقط لازم است اگر همین سرور
# برای تست کنترل‌پلین چندتننتی هم استفاده می‌شود، نه برای استقرار عادی
# مشتری. اگر این سه خط پر نشوند، سرویس admin اجرا نمی‌شود.
ADMIN_EXPOSED_PORT=8081
ADMIN_PANEL_API_URL=
CORS_ORIGINS=

# registry.npmjs.org is blocked outright on some Iranian networks (the build
# hangs with no error until it eventually times out — if `docker compose
# build` seems stuck at an "npm ci" step, this is almost certainly why).
# Leave empty to use the default registry; set to a reachable mirror
# otherwise, e.g.:
NPM_REGISTRY=
