{
  "id": "/",
  "name": "اکسیر ERP",
  "short_name": "اکسیر",
  "description": "مدیریت یکپارچه‌ی کسب‌وکار — فروش، انبار، حسابداری و منابع انسانی",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "dir": "rtl",
  "lang": "fa",
  "background_color": "#011840",
  "theme_color": "#011840",
  "categories": ["business", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "کارتابل", "short_name": "کارتابل", "url": "/approvals", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "پیام‌رسان", "short_name": "پیام‌رسان", "url": "/messenger", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "وظایف", "short_name": "وظایف", "url": "/tasks", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "یادآوری‌ها", "short_name": "یادآوری", "url": "/dashboard?reminders=1", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
