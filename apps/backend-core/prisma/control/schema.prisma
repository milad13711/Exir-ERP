// Control Plane schema — one shared database for the whole SaaS.
// Holds everything that must exist BEFORE a tenant database can be found:
// tenant directory, subscriptions/billing, module catalog, internal staff
// (the "تیم مدیریت") and cross-tenant support tickets.
//
// Business data for a tenant itself never lives here — see prisma/tenant/schema.prisma,
// which is applied as a fresh, isolated database per tenant.

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/control-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_DATABASE_URL")
}

// ── Identity (global, spans tenants) ───────────────────────────────────────

model GlobalUser {
  id          String    @id @default(uuid())
  phone       String    @unique
  name        String?
  avatarUrl   String? // data URI — یک تصویر برای این شخص، مشترک بین همه‌ی محیط‌های کاری او
  isSuperUser Boolean   @default(false)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  /// 2FA اختیاری (TOTP) برای OWNER/ADMIN — راز به‌صورت AES-256-GCM (APP_SECRETS_KEY) ذخیره می‌شود، هرگز متن ساده.
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  totpLastStep       Int?
  recoveryCodeHashes String[] @default([])

  memberships    TenantMembership[]
  supportTickets SupportTicket[]

  @@map("global_users")
}

enum OtpPurpose {
  LOGIN
  TENANT_INVITE
  SIGNUP
  BOOKING
  TRACKING
  CONTRACT_SIGN
  LAB_REVIEW
  RATION_RESULT
  STORE_ORDER
  CONFIDENTIAL_ARCHIVE
}

model OtpCode {
  id         String     @id @default(uuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose @default(LOGIN)
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

// ── Tenant directory ────────────────────────────────────────────────────────

enum TenantStatus {
  PENDING_PROVISION
  PENDING_PAYMENT // provisioned (DB/modules/owner all set up) but blocked until the setup invoice is paid
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum DeploymentType {
  SHARED_CLOUD
  DEDICATED_ON_PREMISE
}

model Tenant {
  id             String         @id @default(uuid())
  slug           String         @unique
  /// شناسه‌ی عمومی و غیرقابل‌حدس برای لینک‌های عمومی (رزرو، فاکتور، قرارداد و...) — به‌جای slug خوانا
  publicKey      String         @unique @default(dbgenerated("('t' || substr(md5(random()::text || clock_timestamp()::text), 1, 11))"))
  name           String
  status         TenantStatus   @default(PENDING_PROVISION)
  deploymentType DeploymentType @default(SHARED_CLOUD)

  // Database-per-tenant connection info (shared_cloud: points at our cluster;
  // dedicated_on_premise: points at the tenant's own licensed server once activated).
  dbHost String @default("127.0.0.1")
  dbPort Int    @default(5433)
  dbName String @unique

  // logoUrl lives in the tenant DB's ModuleSetting store (settings/general),
  // not here — see GeneralSettingsController. themeColor has no other home.
  themeColor String?

  /// افزایش آن همه‌ی توکن‌های ورودِ این تننت را باطل می‌کند (پاسخ به نفوذ/اخراج گروهی).
  tokenVersion Int @default(0)

  createdAt     DateTime  @default(now())
  provisionedAt DateTime?
  suspendedAt   DateTime?
  suspendReason String?

  memberships    TenantMembership[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  smsWallet      TenantSmsWallet?
  tenantModules  TenantModule[]
  supportTickets SupportTicket[]
  auditLogs      AuditLog[]
  smsLogs        SmsLog[]
  errorLogs      ErrorLog[]
  licenses       License[]
  apiKeys        ApiKey[]
  webhooks       WebhookSubscription[]

  @@map("tenants")
}

// ── Developer platform: API keys, REST access, webhooks ────────────────────
// (MCP re-uses the same ApiKey model — an MCP client authenticates with the
// same key as a REST API caller, just against /mcp instead of /api/*.)

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  name       String // label the tenant chose, e.g. "اسکریپت گزارش‌گیری"
  keyPrefix  String // first 12 chars of the raw key, shown for identification (never the secret)
  keyHash    String // bcrypt hash of the full raw key — the raw key is shown to the tenant exactly once, at creation
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyPrefix])
  @@map("api_keys")
}

model WebhookSubscription {
  id        String   @id @default(uuid())
  tenantId  String
  url       String
  secret    String // used to HMAC-sign delivered payloads, so the receiver can verify authenticity
  events    String[] // e.g. ["crm.deal.created", "task.created"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_subscriptions")
}

enum WebhookDeliveryStatus {
  SUCCESS
  FAILED
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  webhookId      String
  event          String
  payload        Json
  status         WebhookDeliveryStatus
  responseStatus Int?
  error          String?
  createdAt      DateTime              @default(now())

  webhook WebhookSubscription @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

// Coarse-grained: "does this person belong to this tenant, and at what base role".
// Fine-grained module permissions live inside the tenant's own database
// (see prisma/tenant/schema.prisma → Role/Permission), since they depend on
// which modules that tenant has installed.
model TenantMembership {
  id           String           @id @default(uuid())
  tenantId     String
  globalUserId String
  role         TenantRole       @default(MEMBER)
  status       MembershipStatus @default(INVITED)
  invitedAt    DateTime         @default(now())
  joinedAt     DateTime?
  /// افزایش آن فقط نشست‌های همین عضو را باطل می‌کند.
  tokenVersion Int          @default(0)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  globalUser GlobalUser @relation(fields: [globalUserId], references: [id], onDelete: Cascade)

  @@unique([tenantId, globalUserId])
  @@map("tenant_memberships")
}

// ── Billing ─────────────────────────────────────────────────────────────────

model Plan {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  priceMonthly   Int // Toman
  priceYearly    Int? // Toman — null means "no yearly discount configured yet", quote falls back to priceMonthly*12
  userLimit      Int
  isPubliclySold Boolean  @default(true)
  createdAt      DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id               String             @id @default(uuid())
  tenantId         String
  planId           String
  status           SubscriptionStatus @default(TRIAL)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime
  autoRenew        Boolean            @default(true)
  cancelledAt      DateTime?
  lifetime         Boolean            @default(false) // لایسنس مادام‌العمر: هدر «مادام‌العمر» نشان می‌دهد و تاریخ پایان دور (نمایشی) است

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@map("subscriptions")
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
}

/// یک فاکتور چه‌بسا چند ماژول را با هم پوشش دهد (خرید سبدی) — items همان
/// ریزخط‌هاست، amount همیشه جمع آن‌ها. برای فاکتورهای قدیمی‌تر (تنظیم تننت،
/// تمدید پلن) items خالی/تعریف‌نشده می‌ماند و amount همان مقدار یکجای قبلی است.
enum InvoicePurpose {
  TENANT_SETUP
  PLAN_RENEWAL
  MODULE_PURCHASE
  MODULE_RENEWAL
  SMS_PACKAGE
}

model Invoice {
  id                String          @id @default(uuid())
  tenantId          String
  subscriptionId    String?
  amount            Int // Toman
  status            InvoiceStatus   @default(PENDING)
  purpose           InvoicePurpose?
  items             Json? // [{ moduleCode, moduleName, billingMode, amount }] — فقط برای فاکتورهای ماژولی
  issuedAt          DateTime        @default(now())
  dueAt             DateTime
  paidAt            DateTime?
  // Set when a Zarinpal payment is initiated for this invoice — lets the
  // callback verify against the exact attempt it started (not just trust
  // whatever Authority a request happens to carry) and stops a stale/reused
  // Authority from marking a different invoice paid.
  zarinpalAuthority String?         @unique
  paymentRefId      Int? // Zarinpal's ref_id once a payment verifies successfully

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("invoices")
}

// ── Module marketplace catalog ─────────────────────────────────────────────

model ModuleDefinition {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String
  category     String
  priceMonthly Int      @default(0) // 0 = included in every plan
  licenseUsd   Int      @default(0) // قیمت پایه‌ی دلاری (لایسنس مادام‌العمر)؛ >۰ یعنی قیمت‌های تومانی از روی آن و نرخ روز مشتق می‌شوند
  priceYearly  Int? // null = بدون تخفیف سالانه‌ی تعریف‌شده، معادل priceMonthly*12 محاسبه می‌شود
  isCore       Boolean  @default(false) // رایگان و پیش‌فرض فعال — اما همچنان قابل غیرفعال‌سازی توسط تننت
  // پیش‌فرض true یعنی در فروشگاه ماژول به همه‌ی تننت‌ها نشان داده می‌شود؛ false
  // یعنی از کاتالوگ عمومی مخفی است (مثلاً book-store که فقط برای یک تننت خاص
  // ساخته شده، نه یک محصول قابل‌فروش عمومی) — نصب/دسترسی تننتی که از قبل این
  // ماژول را دارد کاملاً دست‌نخورده می‌ماند چون ModuleGuard و install/uninstall
  // مستقیماً از روی TenantModule کار می‌کنند، نه این پرچم (نک: ModulesCatalogController.list).
  isListed     Boolean  @default(true)
  version      String   @default("1.0.0")
  dependsOn    String[] @default([]) // کدهای ماژول‌هایی که باید قبل از این یکی فعال باشند
  features     String[] @default([]) // bullet points shown on the module's store card
  createdAt    DateTime @default(now())

  // محتوای دموی این ماژول — دو تصویر از محیط داخلی + توضیح + ارزش‌های ایجادشده برای سازمان.
  demoDescription    String?
  demoValueProps      String[] @default([])
  demoScreenshot1Url  String?
  demoScreenshot2Url  String?

  tenantModules TenantModule[]

  @@map("module_definitions")
}

enum TenantModuleStatus {
  INSTALLED
  TRIAL
  DISABLED
}

/// LICENSE هیچ‌وقت منقضی نمی‌شود (currentPeriodEnd آن null می‌ماند).
enum ModuleBillingMode {
  MONTHLY
  YEARLY
  LICENSE
}

model TenantModule {
  id          String             @id @default(uuid())
  tenantId    String
  moduleId    String
  status      TenantModuleStatus @default(INSTALLED)
  installedAt DateTime           @default(now())

  // دوره‌ی خریداری‌شده — برای ماژول‌های رایگان/هسته null می‌ماند.
  billingMode      ModuleBillingMode?
  currentPeriodEnd DateTime? // null برای LICENSE (هیچ‌وقت منقضی نمی‌شود) یا ماژول رایگان

  // فاکتور تمدیدِ در انتظار پرداختِ فعلی این ماژول (اگر باشد) — برای هشدار
  // ۱۰-روزه در هدر و جلوگیری از صدور فاکتور تمدید تکراری.
  pendingRenewalInvoiceId String? @unique

  // حالت آزمایشی/دمو — هر ماژول فقط یک بار در کل عمرش قابل دمو کردن است؛
  // با ثبت اولین رکورد (اولین POST) خودکار غیرفعال می‌شود.
  trialActivatedAt    DateTime?
  trialRecordCreatedAt DateTime?

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module ModuleDefinition @relation(fields: [moduleId], references: [id])

  @@unique([tenantId, moduleId])
  @@map("tenant_modules")
}

// ── Internal management/support team (never tenant users) ─────────────────

enum StaffTeam {
  SUPER_ADMIN
  SUPPORT
  BILLING
  ENGINEERING
}

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  team         StaffTeam @default(SUPPORT)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  /// قفل موقت پس از چند ورود ناموفق پیاپی
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  /// افزایش آن همه‌ی توکن‌های این کارشناس را باطل می‌کند
  tokenVersion     Int       @default(0)
  /// 2FA (TOTP) — راز رمزشده با APP_SECRETS_KEY؛ کدهای بازیابی فقط به‌صورت هش
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  totpLastStep       Int?
  recoveryCodeHashes String[] @default([])
  /// رمز پیش‌فرض/یک‌بارمصرف: تا تغییر رمز فقط /admin/auth/me و /admin/auth/change-password مجازند
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?

  assignedTickets SupportTicket[]
  issuedLicenses  License[]

  assignedInternalTasks InternalTask[]          @relation("AssignedInternalTasks")
  createdInternalTasks  InternalTask[]          @relation("CreatedInternalTasks")
  ownedLeads            InternalLead[]
  pushSubscriptions     AdminPushSubscription[]
  reviewedResellerApplications ResellerApplication[]

  @@map("admin_users")
}

/// یک اشتراک push-notification مرورگر برای یک عضو تیم ادمین — روی هر
/// دستگاه/مرورگری که "فعال‌سازی اعلان‌ها" را بزند یک ردیف جدید ساخته
/// می‌شود (چند دستگاه هم‌زمان مجاز است).
model AdminPushSubscription {
  id          String   @id @default(uuid())
  adminUserId String
  endpoint    String   @unique
  p256dh      String
  auth        String
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("admin_push_subscriptions")
}

// ── Internal ops (Exir's own team — task/reminder management and its own
// sales pipeline for prospective tenants, run from inside the admin panel
// itself; entirely separate from any tenant's own CRM/Tasks module) ───────

enum InternalTaskStatus {
  OPEN
  DONE
}

model InternalTask {
  id           String             @id @default(uuid())
  title        String
  description  String?
  status       InternalTaskStatus @default(OPEN)
  dueAt        DateTime?
  assignedToId String?
  createdById  String
  ticketId     String? // اگر از روی یک تیکت پشتیبانی ساخته شده
  createdAt    DateTime           @default(now())
  completedAt  DateTime?

  assignedTo AdminUser?     @relation("AssignedInternalTasks", fields: [assignedToId], references: [id])
  createdBy  AdminUser      @relation("CreatedInternalTasks", fields: [createdById], references: [id])
  ticket     SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([assignedToId])
  @@index([ticketId])
  @@map("internal_tasks")
}

enum InternalLeadStage {
  NEW
  CONTACTED
  PROPOSAL
  WON
  LOST
}

model InternalLead {
  id                            String            @id @default(uuid())
  name                          String
  company                       String?
  phone                         String?
  email                         String?
  stage                         InternalLeadStage @default(NEW)
  value                         Int? // estimated deal value, Toman
  notes                         String?
  // Set only for leads that came from the marketing site's plan
  // configurator — lets admin's "Convert to Tenant" prefill NewTenantModal
  // instead of staff retyping what the visitor already chose.
  requestedPlanCode             String?
  requestedIndustryTemplateCode String?
  ownerAdminId                  String?
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt

  owner AdminUser? @relation(fields: [ownerAdminId], references: [id])

  @@index([stage])
  @@map("internal_leads")
}

// ── درخواست همکاری در فروش (نمایندگی) — از فرم عمومی «همکاری با ما» در
// eta.co.ir؛ پس از بررسی مدیر، با approve به یک ResellerProfile واقعی در
// تننت رجیستری (eta) تبدیل می‌شود — ببینید ResellerApplicationsService. ──

enum ResellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model ResellerApplication {
  id                String                    @id @default(uuid())
  name              String
  company           String?
  phone             String
  email             String?
  city              String?
  websiteUrl        String?
  productCode       String? // 'ERP' | 'REAL_ESTATE' | 'SMS_GATEWAY' | 'OTHER' — به ResellerProfile.productCode (تننت eta) نگاشت می‌شود
  message           String?
  status            ResellerApplicationStatus @default(PENDING)
  reviewedByAdminId String?
  reviewedAt        DateTime?
  rejectionNote     String?
  createdAt         DateTime                  @default(now())

  reviewedBy AdminUser? @relation(fields: [reviewedByAdminId], references: [id])

  @@index([status])
  @@map("reseller_applications")
}

// ── On-premise licensing ────────────────────────────────────────────────────
// A License is issued by the management team for a DEDICATED_ON_PREMISE tenant
// that runs the full stack on its own server. `signedKey` is an offline-verifiable
// Ed25519-signed token (see src/licensing) — the on-prem deployment verifies it
// locally with our public key, with no need to phone home. `verifyLicense` below
// is an OPTIONAL online check-in an on-prem deployment can call if it does have
// connectivity, to catch a revocation before the token's own expiry.

enum LicenseStatus {
  ACTIVE
  REVOKED
}

model License {
  id              String        @id @default(uuid())
  tenantId        String?
  orgName         String
  signedKey       String        @unique // the full "<payload>.<signature>" offline token
  allowedModules  String[]
  seats           Int           @default(10)
  status          LicenseStatus @default(ACTIVE)
  issuedAt        DateTime      @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedReason   String?
  issuedByAdminId String?
  lastCheckInAt   DateTime? // آخرین باری که سرور on-premise این لایسنس به ما وصل شد (بهترین تلاش — نشانه‌ی زنده‌بودن اتصال، نه یک الزام)
  lastCheckInIp   String?

  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  issuedByAdmin AdminUser? @relation(fields: [issuedByAdminId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("licenses")
}

// ── Cross-tenant live support → task handoff ───────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  URGENT
}

model SupportTicket {
  id              String         @id @default(uuid())
  tenantId        String
  createdByUserId String
  subject         String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  assignedAdminId String?
  createdAt       DateTime       @default(now())
  resolvedAt      DateTime?
  resolutionNote  String?

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser GlobalUser       @relation(fields: [createdByUserId], references: [id])
  assignedAdmin AdminUser?       @relation(fields: [assignedAdminId], references: [id])
  messages      SupportMessage[]
  internalTasks InternalTask[]

  @@map("support_tickets")
}

enum SenderType {
  TENANT_USER
  ADMIN
  SYSTEM
}

model SupportMessage {
  id         String     @id @default(uuid())
  ticketId   String
  senderType SenderType
  senderId   String? // GlobalUser.id or AdminUser.id, depending on senderType
  body       String
  createdAt  DateTime   @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("support_messages")
}

// ── Central audit + error log (control-plane-level events) ────────────────
// Tenant-scoped business activity/errors are logged inside each tenant DB;
// this table is for cross-tenant, platform-level events the management
// team needs visibility into (tenant created, plan changed, admin actions...).

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String // "global_user" | "admin_user" | "system"
  actorId    String?
  tenantId   String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// لاگ همه‌ی پیامک‌هایی که سیستم می‌فرستد (OTP، اعلان‌ها، پیامک تننت‌ها) — موفق یا ناموفق، با دلیل خطا.
model SmsLog {
  id        String   @id @default(uuid())
  tenantId  String?
  source    String // PLATFORM | TENANT_OWN | TENANT_SYSTEM | TENANT_LEGACY
  phone     String
  message   String
  success   Boolean
  error     String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
  @@index([success])
  @@map("sms_logs")
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  FATAL
}

model ErrorLog {
  id         String   @id @default(uuid())
  tenantId   String?
  service    String // e.g. "backend-core", "web-panel"
  level      LogLevel @default(ERROR)
  message    String
  stackTrace String?
  context    Json?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
  @@map("error_logs")
}

// ── Industry templates (قالب صنف) ───────────────────────────────────────────

/**
 * A reusable master seed per industry/trade — so onboarding a new tenant in
 * an already-covered industry (e.g. another livestock-feed manufacturer)
 * doesn't require personalizing roles, chart-of-accounts, and org structure
 * from scratch again. Applied once, at tenant-creation time, by
 * `seedDefaultTenantData` (see apps/backend-core/src/tenants/default-tenant-data.seed.ts).
 * `roles` and `chartOfAccounts` are actually seeded into the new tenant's
 * database (real Role/Permission/ModulePermission and Account rows).
 * `productCategories` and `orgChart` are reference/suggestion data only —
 * there's no Category or OrgChart table in the tenant schema to seed real
 * rows into (a brand-new tenant has zero products and shouldn't get fake
 * placeholder employees), so these stay descriptive JSON for a future
 * onboarding UI to surface as suggestions.
 * Authoring/editing templates (an admin-panel UI) and how a template gets
 * picked at tenant-creation time in the UI are explicitly out of scope for
 * now — templates are seeded by `prisma/control/seed.ts` today; this model
 * exists so `CreateTenantDto.industryTemplateCode` has something real to
 * look up.
 */
/// دسته‌بندی سطح‌بالای صنف — پایه‌ی مرحله‌ی اول ویزارد ثبت‌نام عمومی
/// («کسب‌وکارتان خدماتی، بازرگانی یا تولیدی است؟») پیش از نمایش صنف‌های
/// همان دسته.
enum IndustryBusinessCategory {
  SERVICES // خدماتی
  TRADE // بازرگانی
  PRODUCTION // تولیدی
}

model IndustryTemplate {
  id                  String                    @id @default(uuid())
  code                String                    @unique // e.g. "livestock-feed"
  name                String // نام صنف، مثلاً «خوراک دام»
  description         String?
  businessCategory    IndustryBusinessCategory? // خالی فقط برای قالب‌های خیلی قدیمی/دستی — صنف‌های seed همه مقداردهی شده‌اند
  roles               Json // Array<{ name, permissionCodes: string[], modulePermissions: Record<moduleCode, matrix> }>
  chartOfAccounts     Json // Array<{ code, name, type, isCashAccount? }> — افزوده‌ی صنعتی روی کدینگ پایه
  productCategories   Json // string[] — دسته‌بندی‌های پیشنهادی کالا
  orgChart            Json // Array<{ position, reportsTo: string | null, department }>
  suggestedThemeColor String?
  defaultModules      String[]                  @default([]) // ModuleDefinition.code[] installed automatically on tenant creation
  createdAt           DateTime                  @default(now())

  @@map("industry_templates")
}

// ── بسته‌های پیامکی پنل سیستمی ───────────────────────────────────────────────
// تننتی که پنل پیامکی اختصاصی ندارد می‌تواند از پنل مشترک اکسیر استفاده کند و
// بسته بخرد. قیمت هر بسته را مدیر پلتفرم در پنل ادمین تعیین می‌کند؛ قیمت صفر
// یا غیرفعال یعنی قابل خرید نیست.

model SmsPackage {
  id         String   @id @default(uuid())
  code       String   @unique // مثلاً SMS_500
  credits    Int // تعداد پیامک
  priceToman Int      @default(0)
  isActive   Boolean  @default(false)
  sortOrder  Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("sms_packages")
}

/// اعتبار پیامکی باقی‌مانده‌ی تننت روی پنل سیستمی — با پرداخت فاکتور SMS_PACKAGE فوراً شارژ می‌شود.
model TenantSmsWallet {
  tenantId  String   @id
  credits   Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_sms_wallets")
}

/// وضعیت امنیتی سراسری پلتفرم (یک ردیف: id = "global"). sessionEpoch با «خروج اجباری همه» بالا می‌رود
/// و هر توکن صادرشده با نسخه‌ی کمتر (tenant یا admin) نامعتبر می‌شود.
model SecurityState {
  id           String   @id
  sessionEpoch Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("security_state")
}
