// Tenant schema — applied as-is to a fresh, isolated database for every
// tenant (database-per-tenant). Business data for ONE tenant only; never
// shared across tenants. Cross-tenant concerns (billing, module catalog,
// support tickets, the management team) live in prisma/control/schema.prisma.

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/tenant-client"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

// ── Users, roles & permissions (fine-grained, module-aware) ────────────────

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(uuid())
  globalUserId String     @unique // points at Control Plane GlobalUser.id (no cross-db FK)
  name         String
  email        String?
  phone        String
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now())

  roles                         UserRole[]
  tasks                         Task[]                     @relation("TaskAssignee")
  activityLogs                  ActivityLog[]
  ownedContacts                 CrmContact[]               @relation("CrmContactOwner")
  ownedDeals                    CrmDeal[]                  @relation("CrmDealOwner")
  crmActivities                 CrmActivity[]
  journalEntries                JournalEntry[]
  stockMovements                StockMovement[]
  reviewedLeaveRequests         LeaveRequest[]
  notifications                 Notification[]
  notificationPreference        NotificationPreference?
  createdInvoices               SalesInvoice[]
  signedInvoices                SalesInvoice[]             @relation("SalesInvoiceSigner")
  createdQuotations             SalesQuotation[]
  createdSalesReturns           SalesReturn[]
  createdPurchaseReturns        PurchaseReturn[]
  createdPurchaseOrders         PurchaseOrder[]
  approvedPurchaseOrders        PurchaseOrder[]            @relation("PurchaseOrderApprover")
  checks                        Check[]
  partyTransactions             PartyTransaction[]
  bankStatementLines            BankStatementLine[]
  recurringInvoiceTemplates     RecurringInvoiceTemplate[]
  budgets                       Budget[]
  fixedAssets                   FixedAsset[]
  attachments                   Attachment[]
  createdBoms                   BillOfMaterial[]
  createdProductionOrders       ProductionOrder[]          @relation("ProductionOrderCreatedBy")
  rawMaterialApprovals          ProductionOrder[]          @relation("ProductionOrderRawApprover")
  assignedProductionStages      ProductionOrderStage[]
  qualitySamplesTaken           QualitySample[]            @relation("QualitySampleSampledBy")
  qualitySampleResultsTested    QualitySampleResult[]      @relation("QualitySampleResultTestedBy")
  createdAutomationRules        AutomationRule[]
  voipExtension                 VoipExtension?
  decidedAiActions              AiActionRequest[]
  providedAppointments          Appointment[]              @relation("AppointmentProvider")
  createdAppointments           Appointment[]              @relation("AppointmentCreatedBy")
  staffAvailabilitySlots        StaffAvailabilitySlot[]
  createdContracts              Contract[]
  referredContractsToSign       Contract[]                 @relation("ContractReferredSigner")
  createdContractTemplates      ContractTemplate[]
  createdContractAmendments     ContractAmendment[]
  managedProjects               Project[]                  @relation("ProjectManager")
  createdProjects               Project[]                  @relation("ProjectCreatedBy")
  requestedStages               ProjectStage[]             @relation("ProjectStageRequestedBy")
  approvedStages                ProjectStage[]             @relation("ProjectStageApprovedBy")
  responsibleForStages          ProjectStage[]             @relation("ProjectStageResponsible")
  projectMemberships            ProjectMember[]            @relation("ProjectMemberUser")
  createdShipments              Shipment[]
  createdCampaigns              MarketingCampaign[]
  mentoringEngagementsAsAdvisor MentoringEngagement[]      @relation("MentoringAdvisor")
  createdMentoringEngagements   MentoringEngagement[]      @relation("MentoringEngagementCreatedBy")
  createdMentoringSessions      MentoringSession[]         @relation("MentoringSessionCreatedBy")
  createdEvents                 Event[]
  checkedInEventTickets         EventTicket[]              @relation("EventTicketCheckedInBy")
  createdForms                  Form[]
  createdWarrantyCodes          WarrantyCode[]

  @@map("users")
}

model Role {
  id       String  @id @default(uuid())
  name     String
  isSystem Boolean @default(false) // system roles (e.g. "مدیر سیستم") cannot be deleted

  users             UserRole[]
  permissions       RolePermission[]
  modulePermissions ModulePermission[]

  @@unique([name])
  @@map("roles")
}

// The access matrix an admin configures per role, per module: view own
// records vs every record, plus create/edit/delete. This is the ONLY
// permission model actually enforced by controllers — the atomic
// Permission/RolePermission pair above is legacy and unused by any guard.
model ModulePermission {
  id         String  @id @default(uuid())
  roleId     String
  moduleCode String // "crm" | "accounting" | "warehouse" | "hr" | "tasks"
  canViewAll Boolean @default(false)
  canViewOwn Boolean @default(true)
  canCreate  Boolean @default(false)
  canEdit    Boolean @default(false)
  canDelete  Boolean @default(false)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleCode])
  @@map("module_permissions")
}

// code is namespaced per module, e.g. "crm.leads.write", "settings.users.manage"
model Permission {
  id          String @id @default(uuid())
  code        String @unique
  moduleCode  String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ── Base infrastructure every tenant gets regardless of installed modules ──

enum TaskPriority {
  NORMAL
  MEDIUM
  URGENT
}

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id              String       @id @default(uuid())
  title           String
  dueAt           DateTime?
  priority        TaskPriority @default(NORMAL)
  status          TaskStatus   @default(OPEN)
  assignedUserId  String?
  relatedModule   String? // e.g. "crm", "accounting" — null for general tasks
  relatedEntityId String?
  createdAt       DateTime     @default(now())
  completedAt     DateTime?

  assignee  User?      @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@map("tasks")
}

enum ReminderChannel {
  IN_APP
  SMS
  EMAIL
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}

model Reminder {
  id        String          @id @default(uuid())
  taskId    String?
  title     String
  remindAt  DateTime
  channel   ReminderChannel @default(IN_APP)
  status    ReminderStatus  @default(PENDING)
  createdAt DateTime        @default(now())

  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

// ── Activity + error logs (tenant-scoped) ──────────────────────────────────

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("activity_logs")
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  FATAL
}

model ErrorLog {
  id         String   @id @default(uuid())
  moduleCode String?
  level      LogLevel @default(ERROR)
  message    String
  stackTrace String?
  context    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("error_logs")
}

// ── Notifications: in-app + the per-user email/SMS channel toggles that
// gate NotificationsService.notify() calls made from other modules ───────

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // e.g. "task.assigned", "leave.reviewed" — free-form, per calling module
  title     String
  body      String?
  link      String? // relative in-app path to navigate to on click
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  userId       String  @id
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ── CRM: مدیریت ارتباط با مشتری (contacts, sales pipeline, activity timeline) ─

enum CrmContactType {
  INDIVIDUAL
  COMPANY
}

/// مراحل قیف سرنخ/مشتری. NEW_LEAD..CUSTOMER بخش بالای قیف (پیش از اولین خرید)
/// است؛ REPEAT_CUSTOMER/BRAND_AMBASSADOR/CHURN_RISK/CHURNED سه‌گانه‌ی سلامت
/// برند در پایین قیف‌اند و پس از اولین خرید، به‌صورت خودکار محاسبه می‌شوند —
/// نه با ورودی دستی کاربر (به‌جز پیشروی دستی NEW_LEAD..QUALIFIED).
enum CrmFunnelStage {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  CUSTOMER
  REPEAT_CUSTOMER
  BRAND_AMBASSADOR
  CHURN_RISK
  CHURNED
}

/// شخص/سازمان طرف‌حساب — می‌تواند مشتری، تأمین‌کننده، یا هر دو باشد (isCustomer/isSupplier).
/// قبلاً تأمین‌کننده‌ها مدل جدای Supplier داشتند که وقتی یک نفر هم مشتری بود هم
/// تأمین‌کننده، گردش حسابش بین دو رکورد جدا پخش می‌شد — این‌جا یکی شده‌اند.
model CrmContact {
  id          String         @id @default(uuid())
  type        CrmContactType @default(INDIVIDUAL) // نوع کسب‌وکار: INDIVIDUAL = B2C, COMPANY = B2B
  name        String
  company     String?
  phone       String?
  email       String?
  tags        String[]       @default([])
  ownerUserId String?
  isCustomer  Boolean        @default(true)
  isSupplier  Boolean        @default(false)
  createdAt   DateTime       @default(now())

  // ── قیف سرنخ/مشتری و سلامت برند ──
  funnelStage        CrmFunnelStage @default(NEW_LEAD)
  source             String? // منبع آشنایی: اینستاگرام، معرفی، وب‌سایت، تلفنی، حضوری، سایر (متن آزاد)
  acquisitionCost    Int? // هزینه‌ی جذب این سرنخ به تومان — دستی، برای KPI میانگین CAC
  referredById       String? // چه کسی این سرنخ را معرفی کرده — معرف پس از این ارجاع سفیر برند می‌شود
  isBrandAmbassador  Boolean        @default(false)
  becameAmbassadorAt DateTime?
  firstPurchaseAt    DateTime?
  lastPurchaseAt     DateTime?
  purchaseCount      Int            @default(0)
  avgPurchaseGapDays Int? // میانگین فاصله‌ی روزهای بین خریدهای متوالی — مبنای پیش‌بینی خرید بعدی/ریسک ریزش
  churnWarningAt     DateTime? // از چه زمانی هشدار ریسک غیرفعال‌شدن روی این مشتری فعال شد

  // برای درج روی فاکتور رسمی: اشخاص حقیقی با کد ملی، اشخاص حقوقی با کد
  // اقتصادی/شناسه ملی/شماره ثبت شناخته می‌شوند.
  address            String?
  nationalId         String? // کد ملی — اشخاص حقیقی
  economicCode       String? // کد اقتصادی — اشخاص حقوقی
  legalId            String? // شناسه ملی — اشخاص حقوقی
  registrationNumber String? // شماره ثبت شرکت — اشخاص حقوقی

  // ورودی‌های اعتبارسنجی برای مشتری بدون سابقه‌ی خرید — سوابق خرید واقعی
  // مستقیماً از روی SalesInvoice/SalesPayment محاسبه می‌شود (نه ذخیره‌شده).
  hasBouncedChecks       Boolean @default(false) // سابقه‌ی چک برگشتی
  bankAvgMonthlyTurnover Int? // میانگین گردش حساب ماهانه طبق پرینت بانکی، تومان
  creditLimitOverride    Int? // سقف اعتبار دستی — در صورت تنظیم، جایگزین محاسبه‌ی خودکار می‌شود

  owner                     User?                        @relation("CrmContactOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  deals                     CrmDeal[]
  activities                CrmActivity[]
  invoices                  SalesInvoice[]
  quotations                SalesQuotation[]
  checks                    Check[]
  checksEndorsedToMe        Check[]                      @relation("CheckEndorsedTo")
  purchaseOrders            PurchaseOrder[]
  partyTransactions         PartyTransaction[]
  recurringInvoiceTemplates RecurringInvoiceTemplate[]
  appointments              Appointment[]
  contracts                 Contract[]
  contractsAsSecondParty    Contract[]                   @relation("ContractSecondParty")
  projects                  Project[]
  shipments                 Shipment[]
  storeOrders               StoreOrder[]
  mentoringEngagements      MentoringEngagement[]
  eventBookings             EventBooking[]
  formSubmissions           FormSubmission[]
  warrantyCodes             WarrantyCode[]
  referredBy                CrmContact?                  @relation("ContactReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                 CrmContact[]                 @relation("ContactReferral")
  funnelStageEvents         CrmFunnelStageEvent[]
  campaignRecipients        MarketingCampaignRecipient[]

  @@index([createdAt])
  @@index([isSupplier])
  @@index([funnelStage])
  @@index([isBrandAmbassador])
  @@map("crm_contacts")
}

/// لاگ تغییر مرحله‌ی قیف هر مخاطب — مبنای محاسبه‌ی نرخ تبدیل هر مرحله
/// (بر اساس «حداکثر مرحله‌ای که هرکس تا به حال به آن رسیده»)، میانگین زمان
/// در هر مرحله، و رشد ماهانه‌ی سفیران برند. مستقل از CrmActivity نگه داشته
/// شده چون نیاز به fromStage/toStage ساخت‌یافته برای کوئری‌های تجمیعی دارد.
model CrmFunnelStageEvent {
  id         String          @id @default(uuid())
  contactId  String
  fromStage  CrmFunnelStage?
  toStage    CrmFunnelStage
  occurredAt DateTime        @default(now())

  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([toStage, occurredAt])
  @@map("crm_funnel_stage_events")
}

enum CrmDealStage {
  NEW
  CONTACTED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model CrmDeal {
  id              String       @id @default(uuid())
  title           String
  contactId       String
  value           BigInt       @default(0) // تومان — BigInt: مقادیر معاملات می‌توانند از سقف INT4 (~۲.۱ میلیارد) بیشتر باشند
  stage           CrmDealStage @default(NEW)
  ownerUserId     String?
  expectedCloseAt DateTime?
  createdAt       DateTime     @default(now())
  closedAt        DateTime?

  contact                   CrmContact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner                     User?                      @relation("CrmDealOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  activities                CrmActivity[]
  invoices                  SalesInvoice[]
  quotations                SalesQuotation[]
  recurringInvoiceTemplates RecurringInvoiceTemplate[]

  @@index([stage])
  @@index([createdAt])
  @@map("crm_deals")
}

enum CrmActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  STAGE_CHANGE
}

model CrmActivity {
  id        String          @id @default(uuid())
  type      CrmActivityType
  body      String?
  contactId String?
  dealId    String?
  userId    String?
  createdAt DateTime        @default(now())

  contact CrmContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    CrmDeal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("crm_activities")
}

// ── Sales: چرخه‌ی سفارش فروش → فاکتور → پرداخت، متصل به انبار و حسابداری ──
// CONFIRMED کردن یک فاکتور به‌صورت خودکار یک حواله‌ی انبار (StockMovement)
// و یک سند حسابداری بدهکار/بستانکار (JournalEntry) می‌سازد — این همان
// نقطه‌ای است که فروش، انبار و حسابداری واقعاً به هم متصل می‌شوند، نه
// اینکه هر کدام مستقل کار کنند.

enum SalesInvoiceStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model SalesInvoice {
  id              String             @id @default(uuid())
  invoiceNo       Int                @unique @default(autoincrement())
  contactId       String
  dealId          String?
  projectId       String?
  status          SalesInvoiceStatus @default(DRAFT)
  issuedAt        DateTime           @default(now())
  dueAt           DateTime?
  subtotal        Int // تومان
  discount        Int                @default(0)
  taxRate         Int? // درصد مالیات بر ارزش افزوده — فقط فاکتور رسمی
  taxAmount       Int                @default(0)
  total           Int // subtotal - discount + taxAmount
  paidAmount      Int                @default(0)
  notes           String?
  createdByUserId String?
  journalEntryId  String? // سند فروش (بدهکار/بستانکار درآمد) — برای رهگیری، نه رابطه‌ی دوطرفه
  createdAt       DateTime           @default(now())
  confirmedAt     DateTime?

  // فاکتور رسمی فقط با امضای مالک/مدیر معتبر است؛ غیررسمی را نیروی فروش هم می‌تواند امضا کند.
  // شماره‌گذاری فاکتور رسمی از توالی مستقل خودش می‌آید (officialInvoiceNoSeq)، جدا از invoiceNo عمومی.
  isOfficial        Boolean   @default(false)
  officialInvoiceNo Int?      @unique
  signedByUserId    String?
  signedByName      String?
  signatureDataUrl  String? // data:image/png;base64,... — امضای دست‌نویس روی صفحه
  signedAt          DateTime?

  // تأیید تحویل کالا توسط مشتری — با امضا یا کد محرمانه‌ی ارسالی به موبایل مشتری
  deliveryConfirmedAt      DateTime?
  deliveryConfirmedName    String?
  deliverySignatureDataUrl String?
  deliveryCodeHash         String?
  deliveryCodeExpiresAt    DateTime?
  deliveryCodeSentAt       DateTime?

  // آخرین باری که یادآور تکمیل وجه (مانده‌ی فاکتور) برای مشتری و مدیر ارسال شد.
  lastPaymentReminderAt DateTime?

  // پرداخت آنلاین از طریق لینک عمومی فاکتور (پیامکی/دستی) — همان الگوی
  // زرین‌پال بیعانه‌ی نوبت و بلیط رویداد؛ publicToken چون invoiceNo/id
  // نباید برای دسترسی غیرقابل‌احراز حدس‌زدنی باشد.
  publicToken       String  @unique @default(uuid())
  zarinpalAuthority String?
  paymentRefId      Int?

  contact           CrmContact         @relation(fields: [contactId], references: [id])
  deal              CrmDeal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy         User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  signedBy          User?              @relation("SalesInvoiceSigner", fields: [signedByUserId], references: [id], onDelete: SetNull)
  lines             SalesInvoiceLine[]
  payments          SalesPayment[]
  checks            Check[]
  returns           SalesReturn[]
  mentoringSessions MentoringSession[]
  eventBookings     EventBooking[]
  warrantyCodes     WarrantyCode[]

  @@index([contactId])
  @@index([status])
  @@index([projectId])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Int
  unitPrice   Int // تومان — همیشه معتبر و پایه‌ی حسابداری، حتی برای اقلام ارزی
  lineTotal   Int // تومان

  // اگر این قلم از یک کالای ارزی پر شده، نرخ لحظه‌ی صدور فاکتور اینجا قفل
  // می‌شود — صرفاً برای رهگیری/نمایش؛ unitPrice/lineTotal تومانی هرگز از این
  // فیلدها مشتق نمی‌شوند تا محاسبات حسابداری/سود و زیان دست‌نخورده بماند.
  currencyId     String?
  unitPriceFx    Decimal? @db.Decimal(18, 4)
  exchangeRateFx Decimal? @db.Decimal(18, 4)

  invoice  SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product  Product?     @relation(fields: [productId], references: [id])
  currency Currency?    @relation(fields: [currencyId], references: [id])

  warrantyCodes WarrantyCode[]

  @@map("sales_invoice_lines")
}

enum SalesPaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  POS
  ONLINE_GATEWAY
}

enum SalesQuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

/// پیش‌فاکتور — پیشنهاد قیمت به مشتری، قبل از صدور فاکتور رسمی فروش. با
/// تبدیل به فاکتور، یک SalesInvoice جدید ساخته و شناسه‌اش در
/// convertedInvoiceId ثبت می‌شود (فقط برای رهگیری، مثل الگوی journalEntryId
/// روی SalesInvoice — رابطه‌ی دوطرفه‌ی Prisma لازم نیست).
model SalesQuotation {
  id                 String               @id @default(uuid())
  quotationNo        Int                  @unique @default(autoincrement())
  contactId          String
  dealId             String?
  status             SalesQuotationStatus @default(DRAFT)
  issuedAt           DateTime             @default(now())
  validUntil         DateTime?
  subtotal           Int // تومان
  discount           Int                  @default(0)
  total              Int // subtotal - discount
  notes              String?
  createdByUserId    String?
  convertedInvoiceId String?
  createdAt          DateTime             @default(now())
  respondedAt        DateTime?

  // Public customer-facing link (see PublicQuotationsController) — no auth,
  // guarded only by this token being an unguessable random UUID.
  publicToken              String    @unique @default(uuid())
  firstViewedAt            DateTime? // stamped once, on the customer's first open — triggers the sales-rep notification
  acceptedByName           String?
  acceptedSignatureDataUrl String?

  contact   CrmContact           @relation(fields: [contactId], references: [id])
  deal      CrmDeal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdBy User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines     SalesQuotationLine[]

  @@index([contactId])
  @@index([status])
  @@map("sales_quotations")
}

model SalesQuotationLine {
  id          String  @id @default(uuid())
  quotationId String
  productId   String?
  description String
  quantity    Int
  unitPrice   Int // تومان
  lineTotal   Int // تومان

  currencyId     String?
  unitPriceFx    Decimal? @db.Decimal(18, 4)
  exchangeRateFx Decimal? @db.Decimal(18, 4)

  quotation SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?       @relation(fields: [productId], references: [id])
  currency  Currency?      @relation(fields: [currencyId], references: [id])

  @@map("sales_quotation_lines")
}

/// مرجوعی فروش — کالا از یک فاکتور تأییدشده به مشتری برمی‌گردد. سند حسابداری
/// معکوس (بستانکار درآمد/بدهکار موجودی) و رسید انبار در لحظه‌ی ثبت صادر
/// می‌شود؛ چون این خودش یک سند نهایی است، برخلاف فاکتور مرحله‌ی پیش‌نویس ندارد.
model SalesReturn {
  id              String   @id @default(uuid())
  returnNo        Int      @unique @default(autoincrement())
  invoiceId       String
  reason          String?
  subtotal        Int // تومان
  total           Int
  notes           String?
  createdByUserId String?
  journalEntryId  String? // برای رهگیری، مثل الگوی SalesInvoice.journalEntryId
  createdAt       DateTime @default(now())

  invoice   SalesInvoice      @relation(fields: [invoiceId], references: [id])
  createdBy User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines     SalesReturnLine[]

  @@index([invoiceId])
  @@map("sales_returns")
}

model SalesReturnLine {
  id          String  @id @default(uuid())
  returnId    String
  productId   String?
  description String
  quantity    Int
  unitPrice   Int // تومان
  lineTotal   Int // تومان

  return  SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product?    @relation(fields: [productId], references: [id])

  @@map("sales_return_lines")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

/// قالب فاکتور تکرارشونده — به‌جای صدور دستی هر بار، در بازه‌ی مشخص یک
/// SalesInvoice تازه (همیشه پیش‌نویس، تأیید و صدور دستی با کاربر است) از
/// روی همین الگو ساخته می‌شود. cron هر روز الگوهای سررسیدشده را بررسی می‌کند.
model RecurringInvoiceTemplate {
  id                     String              @id @default(uuid())
  contactId              String
  dealId                 String?
  frequency              RecurrenceFrequency
  intervalCount          Int                 @default(1) // مثلاً هر ۲ ماه یک‌بار
  nextRunAt              DateTime
  isActive               Boolean             @default(true)
  discount               Int                 @default(0)
  isOfficial             Boolean             @default(false)
  taxRate                Int?
  notes                  String?
  createdByUserId        String?
  lastRunAt              DateTime?
  lastGeneratedInvoiceId String? // فقط برای رهگیری، مثل الگوی SalesInvoice.journalEntryId
  createdAt              DateTime            @default(now())

  contact   CrmContact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal      CrmDeal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdBy User?                  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines     RecurringInvoiceLine[]

  @@index([nextRunAt])
  @@map("sales_recurring_invoice_templates")
}

model RecurringInvoiceLine {
  id          String  @id @default(uuid())
  templateId  String
  productId   String?
  description String
  quantity    Int
  unitPrice   Int // تومان

  template RecurringInvoiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product?                 @relation(fields: [productId], references: [id])

  @@map("sales_recurring_invoice_lines")
}

/// مرجوعی خرید — کالا به تأمین‌کننده‌ای که سفارشش دریافت شده برگردانده
/// می‌شود. سند حسابداری معکوس (بدهکار حساب‌های پرداختنی/بستانکار موجودی) و
/// حواله‌ی انبار در لحظه‌ی ثبت صادر می‌شود.
model PurchaseReturn {
  id              String   @id @default(uuid())
  returnNo        Int      @unique @default(autoincrement())
  orderId         String
  reason          String?
  subtotal        Int // تومان
  total           Int
  notes           String?
  createdByUserId String?
  journalEntryId  String?
  createdAt       DateTime @default(now())

  order     PurchaseOrder        @relation(fields: [orderId], references: [id])
  createdBy User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines     PurchaseReturnLine[]

  @@index([orderId])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id          String  @id @default(uuid())
  returnId    String
  productId   String?
  description String
  quantity    Int
  unitCost    Int // تومان
  lineTotal   Int // تومان

  return  PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product?       @relation(fields: [productId], references: [id])

  @@map("purchase_return_lines")
}

model SalesPayment {
  id        String             @id @default(uuid())
  invoiceId String
  amount    Int // تومان
  method    SalesPaymentMethod @default(CASH)
  paidAt    DateTime           @default(now())
  note      String?

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("sales_payments")
}

// ── Purchasing: تأمین‌کننده → سفارش خرید → رسید انبار → سند بدهی ──────────
// دریافت (receive) کردن یک سفارش خرید، متقارنِ تأیید فاکتور فروش است: یک
// رسید انبار (افزایش موجودی) و یک سند حسابداری بدهکار موجودی/بستانکار
// حساب‌های پرداختنی می‌سازد.

enum PurchaseOrderStatus {
  DRAFT
  RECEIVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

// Whether a purchase order needs sign-off from an owner/admin before it can
// be received, based on the tenant's configured approval threshold (see
// ModuleSetting moduleCode 'purchasing', key 'approvalThreshold').
enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  orderNo          Int                 @unique @default(autoincrement())
  supplierId       String
  status           PurchaseOrderStatus @default(DRAFT)
  issuedAt         DateTime            @default(now())
  expectedAt       DateTime?
  subtotal         Int // تومان
  total            Int
  paidAmount       Int                 @default(0)
  notes            String?
  createdByUserId  String?
  journalEntryId   String? // سند خرید (بدهکار موجودی/بستانکار حساب‌های پرداختنی) — برای رهگیری
  createdAt        DateTime            @default(now())
  receivedAt       DateTime?
  approvalStatus   ApprovalStatus      @default(NOT_REQUIRED)
  approvedByUserId String?
  approvedAt       DateTime?
  rejectionReason  String?

  supplier   CrmContact          @relation(fields: [supplierId], references: [id])
  createdBy  User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy User?               @relation("PurchaseOrderApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  lines      PurchaseOrderLine[]
  payments   PurchasePayment[]
  checks     Check[]
  returns    PurchaseReturn[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

enum CheckDirection {
  RECEIVED // چک دریافتی از مشتری — نزد ما، در سررسید وصول می‌شود
  ISSUED // چک صادرشده به تأمین‌کننده — نزد طرف مقابل، در سررسید کسر می‌شود
}

enum CheckStatus {
  PENDING // ثبت‌شده (دریافتی) / صادرشده (صادرشده) — هنوز به بانک واگذار نشده
  DEPOSITED // به بانک واگذار شده — در جریان وصول
  CLEARED // پاس‌شده / وصول‌شده
  BOUNCED // برگشت‌خورده
  CANCELLED // باطل‌شده
  ENDORSED // پشت‌نویسی و واگذار به شخص دیگر — به‌جای واگذاری به بانک
}

/**
 * چک‌های دریافتی و صادرشده — با شماره صیادی، مبلغ و سررسید دقیق، تا هم در
 * گزارش‌ها قابل رهگیری باشند و هم پیش از سررسید یادآوری خودکار ارسال شود
 * (ChecksReminderService، پیامک/اعلان/ایمیل به طرف حساب و/یا کارشناس داخلی).
 */
model Check {
  id                  String         @id @default(uuid())
  direction           CheckDirection
  sayadId             String // شماره صیادی ۱۶ رقمی
  amount              Int // تومان
  dueDate             DateTime
  bankName            String?
  status              CheckStatus    @default(PENDING)
  reminderDaysBefore  Int            @default(3)
  reminderSentAt      DateTime?
  clearedAt           DateTime?
  note                String?
  contactId           String? // طرف‌حساب — مشتری (چک دریافتی) یا تأمین‌کننده (چک صادرشده)، هر دو از یک مدل CrmContact
  endorsedToContactId String? // برای چک دریافتیِ پشت‌نویسی‌شده — به چه کسی واگذار شد
  endorsedAt          DateTime?
  invoiceId           String?
  purchaseOrderId     String?
  createdByUserId     String?
  createdAt           DateTime       @default(now())

  contact           CrmContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  endorsedToContact CrmContact?    @relation("CheckEndorsedTo", fields: [endorsedToContactId], references: [id], onDelete: SetNull)
  invoice           SalesInvoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy         User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([dueDate])
  @@index([status])
  @@index([direction])
  @@map("checks")
}

enum PartyTransactionType {
  RECEIPT // دریافت از طرف‌حساب — بدون ارتباط به یک فاکتور خاص (پیش‌پرداخت، تسویه‌ی کلی و ...)
  PAYMENT // پرداخت به طرف‌حساب — بدون ارتباط به یک سفارش خرید خاص
}

/// سند دریافت/پرداخت آزاد — برخلاف SalesPayment/PurchasePayment که به یک
/// فاکتور/سفارش خاص وصل‌اند، این‌جا فقط بدهی/طلب کلی طرف‌حساب (از روی
/// حساب‌های دریافتنی/پرداختنی مشترک ۱۰۳۰/۲۰۱۰) تسویه می‌شود — برای مواردی
/// مثل پیش‌دریافت، کمک مالی، یا تسویه‌ی کلی بدون فاکتور مشخص.
model PartyTransaction {
  id              String               @id @default(uuid())
  partyId         String
  type            PartyTransactionType
  amount          Int // تومان
  accountCode     String // کد حساب نقد/بانکی که وجه از/به آن حرکت کرد (مثلاً 1010 صندوق، 1020 بانک)
  note            String?
  journalEntryId  String?
  createdByUserId String?
  createdAt       DateTime             @default(now())

  party     CrmContact @relation(fields: [partyId], references: [id])
  createdBy User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([partyId])
  @@map("party_transactions")
}

model PurchaseOrderLine {
  id          String  @id @default(uuid())
  orderId     String
  productId   String?
  description String
  quantity    Int
  unitCost    Int // تومان
  lineTotal   Int // تومان

  currencyId     String?
  unitCostFx     Decimal? @db.Decimal(18, 4)
  exchangeRateFx Decimal? @db.Decimal(18, 4)

  order    PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product?      @relation(fields: [productId], references: [id])
  currency Currency?     @relation(fields: [currencyId], references: [id])

  @@map("purchase_order_lines")
}

model PurchasePayment {
  id      String             @id @default(uuid())
  orderId String
  amount  Int // تومان
  method  SalesPaymentMethod @default(CASH)
  paidAt  DateTime           @default(now())
  note    String?

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("purchase_payments")
}

// ── Accounting: کدینگ حسابها، اسناد حسابداری و خزانه‌داری ───────────────────

enum AccountType {
  ASSET // دارایی
  LIABILITY // بدهی
  EQUITY // حقوق صاحبان سهام
  REVENUE // درآمد
  EXPENSE // هزینه
}

model Account {
  id            String      @id @default(uuid())
  code          String      @unique
  name          String
  type          AccountType
  isCashAccount Boolean     @default(false) // صندوق/بانک — برای نمای خزانه‌داری
  isSystem      Boolean     @default(false) // کدینگ پیش‌فرض، غیرقابل حذف
  createdAt     DateTime    @default(now())

  lines              JournalLine[]
  bankStatementLines BankStatementLine[]
  budgetLines        BudgetLine[]

  @@map("accounting_accounts")
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

model JournalEntry {
  id              String             @id @default(uuid())
  number          Int                @unique @default(autoincrement())
  date            DateTime
  description     String?
  status          JournalEntryStatus @default(DRAFT)
  createdByUserId String?
  createdAt       DateTime           @default(now())
  postedAt        DateTime?

  createdBy User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines     JournalLine[]

  @@index([date])
  @@map("accounting_journal_entries")
}

model JournalLine {
  id          String  @id @default(uuid())
  entryId     String
  accountId   String
  debit       BigInt  @default(0) // BigInt: سقف INT4 (~۲.۱ میلیارد) برای مبالغ اسناد بزرگ کافی نیست
  credit      BigInt  @default(0)
  description String?

  entry             JournalEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account           Account            @relation(fields: [accountId], references: [id])
  bankStatementLine BankStatementLine?

  @@index([accountId])
  @@map("accounting_journal_lines")
}

/// ردیف صورت‌حساب بانکی — برای مغایرت‌گیری، دستی وارد می‌شود (بدون اتصال
/// مستقیم به بانک) و در برابر ردیف‌های دفتر (JournalLine) روی همان حساب
/// صندوق/بانک تطبیق داده می‌شود.
model BankStatementLine {
  id                   String    @id @default(uuid())
  accountId            String
  date                 DateTime
  description          String
  amount               BigInt // مثبت = واریز به حساب، منفی = برداشت از حساب
  reference            String?
  matchedJournalLineId String?   @unique
  reconciledAt         DateTime?
  createdByUserId      String?
  createdAt            DateTime  @default(now())

  account            Account      @relation(fields: [accountId], references: [id])
  matchedJournalLine JournalLine? @relation(fields: [matchedJournalLineId], references: [id], onDelete: SetNull)
  createdBy          User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@map("accounting_bank_statement_lines")
}

/// بودجه‌ی یک بازه‌ی زمانی مشخص — مبلغ برنامه‌ریزی‌شده روی هر حساب (معمولاً
/// حساب‌های درآمد/هزینه)؛ مقایسه با واقعیت از روی JournalLine همان بازه در
/// لحظه‌ی گزارش محاسبه می‌شود، نه ذخیره‌شده.
model Budget {
  id              String   @id @default(uuid())
  name            String
  periodStart     DateTime
  periodEnd       DateTime
  createdByUserId String?
  createdAt       DateTime @default(now())

  createdBy User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines     BudgetLine[]

  @@index([periodStart])
  @@map("accounting_budgets")
}

model BudgetLine {
  id        String @id @default(uuid())
  budgetId  String
  accountId String
  amount    Int // تومان — مبلغ بودجه‌ریزی‌شده برای این حساب در این بازه

  budget  Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([budgetId, accountId])
  @@map("accounting_budget_lines")
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
}

/// دارایی ثابت — استهلاک به روش خط مستقیم، در لحظه‌ی نمایش محاسبه می‌شود
/// (نه ذخیره‌شده)؛ postedDepreciation فقط رد می‌کند تا کجای این محاسبه قبلاً
/// به‌عنوان سند حسابداری ثبت شده تا از ثبت دوباره جلوگیری شود.
model FixedAsset {
  id                 String           @id @default(uuid())
  name               String
  category           String?
  purchaseDate       DateTime
  purchaseCost       Int // تومان
  salvageValue       Int              @default(0) // تومان — ارزش اسقاط تخمینی در پایان عمر مفید
  usefulLifeMonths   Int
  status             FixedAssetStatus @default(ACTIVE)
  disposedAt         DateTime?
  disposalAmount     Int?
  postedDepreciation Int              @default(0) // تومان — جمع استهلاکی که تاکنون سند حسابداری‌اش ثبت شده
  notes              String?
  createdByUserId    String?
  createdAt          DateTime         @default(now())

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@map("accounting_fixed_assets")
}

// ── Warehouse: کنترل موجودی، رسید و حواله، هشدار کمبود کالا ────────────────

/// نرخ تبدیل ارز — تومان به ازای هر ۱ واحد این ارز. تومان خودش هیچ ردیفی در
/// این جدول ندارد و ارز پایه‌ی ضمنی سیستم است (currencyId خالی یعنی تومان).
/// نرخ‌ها فعلاً دستی‌اند؛ اتصال به API نرخ لحظه‌ای، ماژول جداگانه‌ی بعدی است.
model Currency {
  id             String    @id @default(uuid())
  code           String    @unique // "USD", "EUR", ...
  name           String
  symbol         String?
  rate           Decimal   @db.Decimal(18, 4)
  isActive       Boolean   @default(true)
  autoUpdate     Boolean   @default(false) // نرخ به‌صورت دوره‌ای از سرویس نرخ ارز آزاد به‌روزرسانی شود
  lastAutoRateAt DateTime? // آخرین باری که به‌روزرسانی خودکار واقعاً نرخ را عوض کرد
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products           Product[]
  invoiceLines       SalesInvoiceLine[]
  quotationLines     SalesQuotationLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@map("currencies")
}

model Product {
  id           String   @id @default(uuid())
  sku          String   @unique
  name         String
  unit         String   @default("عدد")
  category     String?
  costPrice    Int      @default(0) // تومان — بهای تمام‌شده (برای کالای ارزی: آخرین معادل محاسبه‌شده)
  salePrice    Int      @default(0) // تومان — قیمت فروش (برای کالای ارزی: آخرین معادل محاسبه‌شده)
  reorderPoint Int      @default(0) // نقطه سفارش مجدد؛ ۰ یعنی هشدار غیرفعال
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // فروشگاه آنلاین — کالا فقط وقتی isPubliclyListed=true در سایت عمومی نشان
  // داده می‌شود؛ reservedQty یک شمارنده‌ی مستقل از StockMovement است (نه یک
  // تراکنش انبار واقعی) که هنگام ثبت سفارش افزایش و هنگام لغو/ارسال سفارش
  // تسویه می‌شود — موجودی قابل‌فروش = currentStock(movements) − reservedQty.
  isPubliclyListed     Boolean  @default(false)
  publicSlug           String?  @unique
  publicDescription    String?
  publicImages         String[] @default([]) // data URI هر تصویر (بدون فضای ذخیره‌سازی فایل جداگانه)
  reservedQty          Int      @default(0)
  publicCompareAtPrice Int? // تومان — قیمت «قبل از تخفیف» برای نمایش نشان تخفیف در فروشگاه عمومی؛ فقط وقتی از salePrice بیشتر باشد اعمال می‌شود

  reviews StoreReview[]

  // گارانتی و خدمات پس از فروش — وقتی warrantyEnabled باشد، به ازای هر واحد
  // از این کالا در یک فاکتور تسویه‌شده یک کد گارانتی جدا صادر می‌شود.
  warrantyEnabled      Boolean @default(false)
  warrantyDurationDays Int? // خالی یعنی از مقدار پیش‌فرض کل ماژول استفاده شود

  warrantyCodes WarrantyCode[]

  // قیمت‌گذاری ارزی — وقتی currencyId ست شده، costPrice/salePrice معادل
  // تومانی‌شان با نرخ لحظه‌ای Currency.rate محاسبه و نمایش داده می‌شود.
  currencyId  String?
  costPriceFx Decimal? @db.Decimal(18, 4)
  salePriceFx Decimal? @db.Decimal(18, 4)

  currency              Currency?              @relation(fields: [currencyId], references: [id])
  movements             StockMovement[]
  invoiceLines          SalesInvoiceLine[]
  quotationLines        SalesQuotationLine[]
  purchaseLines         PurchaseOrderLine[]
  salesReturnLines      SalesReturnLine[]
  purchaseReturnLines   PurchaseReturnLine[]
  recurringInvoiceLines RecurringInvoiceLine[]
  bomsAsOutput          BillOfMaterial[]       @relation("BomOutput")
  bomLinesAsRawMaterial BillOfMaterialLine[]

  @@index([createdAt])
  @@map("warehouse_products")
}

enum StockMovementType {
  RECEIPT // رسید ورودی
  ISSUE // حواله خروجی
  ADJUSTMENT // اصلاح موجودی
  SALES_RETURN // مرجوعی فروش — کالا از مشتری برمی‌گردد، موجودی افزایش می‌یابد
  PURCHASE_RETURN // مرجوعی خرید — کالا به تأمین‌کننده برگردانده می‌شود، موجودی کاهش می‌یابد
  TRANSFER_OUT // انتقال بین انبارها — کاهش موجودی انبار مبدأ
  TRANSFER_IN // انتقال بین انبارها — افزایش موجودی انبار مقصد
  PRODUCTION_CONSUME // کسر ماده اولیه بابت یک دستور تولید
  PRODUCTION_YIELD // افزایش موجودی محصول نهایی از یک دستور تولید
}

/// انبار فیزیکی — هر StockMovement به یک انبار مشخص تعلق دارد؛ موجودی کل هر
/// کالا مجموع تراکنش‌هایش در همه‌ی انبارهاست، و موجودی هر انبار مجموع
/// تراکنش‌های همان انبار.
model Warehouse {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  address   String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  movements        StockMovement[]
  productionOrders ProductionOrder[]

  @@map("warehouses")
}

model StockMovement {
  id              String            @id @default(uuid())
  productId       String
  warehouseId     String
  type            StockMovementType
  quantityDelta   Int // مثبت = افزایش موجودی، منفی = کاهش موجودی
  unitCost        Int? // تومان — فقط برای رسید، جهت به‌روزرسانی بهای تمام‌شده
  reference       String? // شماره فاکتور/سند مرتبط
  note            String?
  transferGroupId String? // برای TRANSFER_OUT/TRANSFER_IN، دو رکورد یک انتقال را به‌هم وصل می‌کند
  createdByUserId String?
  createdAt       DateTime          @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("warehouse_stock_movements")
}

// ── HR: پرونده پرسنلی، حضور و غیاب، مرخصی و فیش حقوقی ──────────────────────

enum EmploymentStatus {
  ACTIVE
  TERMINATED
}

model Employee {
  id           String           @id @default(uuid())
  employeeCode String           @unique
  fullName     String
  nationalId   String?
  position     String // سمت شغلی
  department   String?
  phone        String?
  email        String?
  hireDate     DateTime
  baseSalary   Int              @default(0) // تومان — حقوق پایه ماهانه
  status       EmploymentStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())

  // Links this HR record to the actual login account, so the system knows
  // whose direct reports a logged-in manager is allowed to approve for.
  // Optional — plenty of employees (e.g. field/production staff) never get
  // a system login at all.
  userId String? @unique

  managerId     String?
  manager       Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Employee[] @relation("EmployeeManager")

  attendance    AttendanceRecord[]
  leaveRequests LeaveRequest[]
  payrollSlips  PayrollSlip[]
  documents     EmployeeDocument[]
  contracts     Contract[]

  @@index([createdAt])
  @@index([managerId])
  @@map("hr_employees")
}

enum EmployeeDocumentType {
  CONTRACT
  NATIONAL_ID
  DEGREE_CERTIFICATE
  OTHER
}

model EmployeeDocument {
  id         String               @id @default(uuid())
  employeeId String
  type       EmployeeDocumentType @default(OTHER)
  title      String
  fileUrl    String
  uploadedAt DateTime             @default(now())
  expiresAt  DateTime? // e.g. a fixed-term contract's end date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("hr_employee_documents")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  employeeId String
  date       DateTime // نیمه‌شب همان روز — یک رکورد به‌ازای هر کارمند در هر روز
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  createdAt  DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@map("hr_attendance_records")
}

enum LeaveType {
  ANNUAL // مرخصی استحقاقی
  SICK // استعلاجی
  UNPAID // بدون حقوق
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id               String      @id @default(uuid())
  employeeId       String
  type             LeaveType
  startDate        DateTime
  endDate          DateTime
  daysCount        Int
  reason           String?
  status           LeaveStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime    @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("hr_leave_requests")
}

enum PayrollStatus {
  DRAFT
  ISSUED
  PAID
}

model PayrollSlip {
  id              String        @id @default(uuid())
  employeeId      String
  periodYear      Int // سال شمسی، مثلاً ۱۴۰۵
  periodMonth     Int // ماه شمسی، ۱ تا ۱۲
  baseSalary      Int
  allowances      Int           @default(0) // مزایا
  deductions      Int           @default(0) // کسورات دستی (وام، جریمه و ...)
  insuranceAmount Int           @default(0) // سهم بیمه‌ی کارمند — خودکار محاسبه می‌شود
  taxAmount       Int           @default(0) // مالیات حقوق — خودکار محاسبه می‌شود
  status          PayrollStatus @default(DRAFT)
  issuedAt        DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodYear, periodMonth])
  @@map("hr_payroll_slips")
}

// ── Per-module settings, centrally editable from Settings → Modules ────────

model ModuleSetting {
  id         String   @id @default(uuid())
  moduleCode String
  key        String
  value      Json
  updatedAt  DateTime @updatedAt

  @@unique([moduleCode, key])
  @@map("module_settings")
}

// ── پیوست فایل عمومی — قابل استفاده روی هر موجودیتی ─────────────────────────

/// پیوست فایل عمومی — فقط لینک را نگه می‌دارد (مثل الگوی از پیش موجود
/// EmployeeDocument)، چون این سیستم زیرساخت آپلود/ذخیره‌ی فایل ندارد.
/// entityType/entityId چندریختی هستند (بدون FK واقعی) تا یک مدل واحد
/// بتواند به هر موجودیتی (فاکتور، مخاطب، تیکت، سفارش خرید...) وصل شود.
model Attachment {
  id              String   @id @default(uuid())
  entityType      String
  entityId        String
  title           String
  fileUrl         String
  createdByUserId String?
  createdAt       DateTime @default(now())

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("generic_attachments")
}

// ── ماژول تولید (production) ────────────────────────────────────────────
// فرمولاسیون (BOM) → دستور تولید → مراحل روی ایستگاه‌های کاری → کسر/افزایش
// خودکار موجودی انبار (از همان StockMovement موجود، نه یک سیستم موازی).
// کنترل کیفیت (ماژول جدا، وابسته به این ماژول) روی QualitySample سوار می‌شود.

/// فرمول تولید یک محصول نهایی — batchOutputQty مقدار پایه‌ی هر بچ است
/// (مثلاً «هر ۱۰۰۰ کیلو») و هر ردیف مصرف آن ماده اولیه به‌ازای همان بچ را
/// می‌گوید؛ برای دستور تولیدی با quantityPlanned دلخواه، مصرف هر ماده با
/// نسبت quantityPlanned/batchOutputQty مقیاس می‌شود. فقط یک نسخه‌ی فعال
/// در هر لحظه برای هر محصول — نسخه‌ی قبلی isActive=false می‌شود، تاریخچه
/// حفظ می‌شود (دستورهای تولید قدیمی همچنان به فرمول قدیمی وصل می‌مانند).
model BillOfMaterial {
  id              String   @id @default(uuid())
  outputProductId String
  batchOutputQty  Int
  version         Int      @default(1)
  isActive        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())

  outputProduct    Product              @relation("BomOutput", fields: [outputProductId], references: [id])
  createdBy        User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines            BillOfMaterialLine[]
  productionOrders ProductionOrder[]

  @@index([outputProductId])
  @@map("production_boms")
}

model BillOfMaterialLine {
  id                   String @id @default(uuid())
  bomId                String
  rawMaterialProductId String
  quantityPerBatch     Int

  bom         BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  rawMaterial Product        @relation(fields: [rawMaterialProductId], references: [id])

  @@index([bomId])
  @@map("production_bom_lines")
}

enum ProductionOrderStatus {
  DRAFT
  RAW_MATERIAL_APPROVED
  IN_PROGRESS
  QC_PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

model ProductionOrder {
  id               String                @id @default(uuid())
  orderNo          Int                   @default(autoincrement())
  bomId            String
  warehouseId      String
  quantityPlanned  Int
  quantityProduced Int?
  status           ProductionOrderStatus @default(DRAFT)

  // برای «تولید سفارشی بر اساس یک فاکتور خاص» — عمداً بدون FK واقعی، فقط
  // برای ردگیری (همان الگوی SalesInvoice.journalEntryId در این schema).
  relatedInvoiceId String?

  plannedStartAt DateTime?
  plannedEndAt   DateTime?
  actualStartAt  DateTime?
  actualEndAt    DateTime?

  rawMaterialApprovedByUserId String?
  rawMaterialApprovedAt       DateTime?
  rawMaterialApprovalNotes    String?

  // ست می‌شود وقتی حداقل یک QualitySample از محصول نهایی این دستور نتیجه‌ی
  // PASS بگیرد (توسط ماژول کنترل کیفیت) — نه یک فیلد تأیید دستی ساده.
  qualityApprovedAt DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())

  bom                   BillOfMaterial         @relation(fields: [bomId], references: [id])
  warehouse             Warehouse              @relation(fields: [warehouseId], references: [id])
  rawMaterialApprovedBy User?                  @relation("ProductionOrderRawApprover", fields: [rawMaterialApprovedByUserId], references: [id], onDelete: SetNull)
  createdBy             User?                  @relation("ProductionOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  stages                ProductionOrderStage[]
  qualitySamples        QualitySample[]

  @@index([status])
  @@index([bomId])
  @@map("production_orders")
}

/// ایستگاه/بخش تولید — داده‌ی پایه‌ی قابل‌تعریف توسط خود تننت (خط دانه‌بندی،
/// خط پلت، بسته‌بندی و ...)، sequenceOrder ترتیب پیش‌فرض نمایش/توالی است.
model WorkCenter {
  id            String  @id @default(uuid())
  name          String
  sequenceOrder Int     @default(0)
  isActive      Boolean @default(true)

  stages ProductionOrderStage[]

  @@map("production_work_centers")
}

enum ProductionStageStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model ProductionOrderStage {
  id                String                @id @default(uuid())
  productionOrderId String
  workCenterId      String
  assignedUserId    String?
  sequenceOrder     Int
  status            ProductionStageStatus @default(PENDING)
  startedAt         DateTime?
  endedAt           DateTime?
  report            String?

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workCenter      WorkCenter      @relation(fields: [workCenterId], references: [id])
  assignedUser    User?           @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  qualitySamples  QualitySample[]

  @@index([productionOrderId])
  @@map("production_order_stages")
}

// ── ماژول کنترل کیفیت (quality-control) — وابسته به production ──────────
// نمونه‌برداری تصادفی از میانه‌ی تولید یا محصول نهایی → نتیجه‌ی هر آزمون
// در برابر بازه‌ی قابل‌قبول تعریف‌شده برای آن آزمون سنجیده و قبول/رد
// خودکار محاسبه می‌شود؛ رد شدن هر نتیجه بلافاصله یک وظیفه برای پیگیری
// می‌سازد و به سازنده‌ی دستور تولید اعلان می‌فرستد.

model QualityTestType {
  id            String   @id @default(uuid())
  name          String
  unit          String
  // هر دو خالی یعنی آزمون فقط اطلاعاتی است، بدون بازه‌ی قبول/رد خودکار.
  acceptableMin Decimal? @db.Decimal(10, 3)
  acceptableMax Decimal? @db.Decimal(10, 3)
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  results QualitySampleResult[]

  @@map("quality_test_types")
}

enum QualitySampleSource {
  IN_PROCESS
  FINAL_PRODUCT
}

enum QualityVerdict {
  PENDING
  PASS
  FAIL
}

model QualitySample {
  id                     String              @id @default(uuid())
  productionOrderId      String
  productionOrderStageId String?
  source                 QualitySampleSource
  sampledByUserId        String?
  sampledAt              DateTime            @default(now())
  note                   String?
  verdict                QualityVerdict      @default(PENDING)
  createdAt              DateTime            @default(now())

  productionOrder      ProductionOrder       @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionOrderStage ProductionOrderStage? @relation(fields: [productionOrderStageId], references: [id], onDelete: SetNull)
  sampledBy            User?                 @relation("QualitySampleSampledBy", fields: [sampledByUserId], references: [id], onDelete: SetNull)
  results              QualitySampleResult[]

  @@index([productionOrderId])
  @@map("quality_samples")
}

model QualitySampleResult {
  id             String         @id @default(uuid())
  sampleId       String
  testTypeId     String
  measuredValue  Decimal        @db.Decimal(10, 3)
  verdict        QualityVerdict
  testedByUserId String?
  testedAt       DateTime       @default(now())
  notes          String?

  sample   QualitySample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  testType QualityTestType @relation(fields: [testTypeId], references: [id])
  testedBy User?           @relation("QualitySampleResultTestedBy", fields: [testedByUserId], references: [id], onDelete: SetNull)

  @@index([sampleId])
  @@map("quality_sample_results")
}

// ── ماژول اتوماسیون (automation) ──────────────────────────────────────
// عمداً بدون هیچ ارجاع ساختاریافته به ماژول‌های دیگر: triggerCode یک
// شناسه‌ی رشته‌ای آزاد است (کاتالوگش در کد هر ماژول، نه اینجا، ثبت
// می‌شود — TriggerRegistryService) و config هر اقدام یک JSON آزاد است.
// همان الگوی entityType/entityId در Attachment/Task، برای همان دلیل: یک
// ماژول جدید نباید نیاز به تغییر این جدول‌ها داشته باشد.

model AutomationRule {
  id              String   @id @default(uuid())
  name            String
  triggerCode     String
  isActive        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())

  createdBy User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  actions   AutomationAction[]
  runLogs   AutomationRunLog[]

  @@index([triggerCode])
  @@map("automation_rules")
}

model AutomationAction {
  id            String @id @default(uuid())
  ruleId        String
  type          String // NOTIFY_IN_APP | SEND_SMS | CREATE_TASK
  config        Json
  sequenceOrder Int    @default(0)

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("automation_actions")
}

model AutomationRunLog {
  id         String   @id @default(uuid())
  ruleId     String
  actionType String
  status     String // SUCCESS | FAILED
  error      String?
  ranAt      DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, ranAt])
  @@map("automation_run_logs")
}

// ── ماژول VoIP (تماس ورودی/خروجی) ──────────────────────────────────────
// یک گیت‌وی مرکزی، نه یک اتصال اختصاصی به یک سرویس خاص: providerCode یک
// کد آزاد است که به VoipProviderRegistry (در کد) اشاره می‌کند — هر
// سرویس/PBX جدید یک آداپتور کوچک در کد اضافه می‌کند، نه تغییری اینجا.

model VoipProviderConfig {
  id            String   @id @default(uuid())
  providerCode  String
  webhookSecret String // برای تأیید صحت وب‌هوک ورودی از سمت PBX
  config        Json // تنظیمات خاص همان provider (base URL، کلید API و ...)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("voip_provider_config")
}

model VoipExtension {
  id        String @id @default(uuid())
  userId    String @unique
  extension String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("voip_extensions")
}

// ── صف تأیید اقدام‌های دستیار هوشمند (MCP) ────────────────────────────
// یک ابزار MCP از نوع CREATE/UPDATE/DELETE هرگز مستقیم اجرا نمی‌شود —
// فقط یک ردیف اینجا می‌سازد؛ اجرای واقعی فقط بعد از approve() انسانی
// اتفاق می‌افتد (همان handler ثبت‌شده‌ی ابزار، دوباره فراخوانی می‌شود).

model AiActionRequest {
  id              String    @id @default(uuid())
  toolName        String
  operationType   String // CREATE | UPDATE | DELETE
  summary         String // توضیح قابل‌فهم برای پاپ‌آپ تأیید
  arguments       Json
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXECUTED | FAILED
  result          Json?
  error           String?
  decidedByUserId String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?
  executedAt      DateTime?

  decidedBy User? @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("ai_action_requests")
}

// ── رزرو نوبت دریافت خدمات ────────────────────────────────────────────

model ServiceType {
  id                   String   @id @default(uuid())
  name                 String
  durationMinutes      Int
  price                Int      @default(0) // تومان
  isActive             Boolean  @default(true)
  requiresDeposit      Boolean  @default(false) // نیاز به واریز بیعانه/پیش‌پرداخت پیش از تأیید نهایی
  depositAmount        Int? // تومان — مبلغ بیعانه (نه لزوماً کل مبلغ خدمت)
  requiresCoordination Boolean  @default(false) // نیاز به هماهنگی اولیه با ارائه‌دهنده پیش از ارسال لینک نهایی ثبت
  createdAt            DateTime @default(now())

  appointments Appointment[]

  @@map("service_types")
}

enum AppointmentStatus {
  PENDING_COORDINATION // منتظر هماهنگی و تأیید داخلی پیش از نهایی‌شدن — فقط برای خدمات requiresCoordination
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentPaymentStatus {
  NONE // این نوبت نیاز به بیعانه ندارد
  PENDING
  PAID
}

model Appointment {
  id              String            @id @default(uuid())
  serviceTypeId   String
  contactId       String?
  providerUserId  String? // کارمند/کارشناس ارائه‌دهنده‌ی خدمت
  customerName    String // مستقل از contactId — مشتری بدون سابقه هم قابل رزرو است
  customerPhone   String?
  startAt         DateTime
  endAt           DateTime
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  cancelReason    String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // بیعانه/پیش‌پرداخت — همان الگوی Zarinpal مورد استفاده در پرداخت فاکتورهای کنترل‌پلین
  paymentStatus     AppointmentPaymentStatus @default(NONE)
  depositAmount     Int?
  zarinpalAuthority String?
  paymentRefId      Int?
  paidAt            DateTime?
  publicToken       String                   @unique @default(uuid()) // لینک عمومی رسید/تکمیل پرداخت

  // هماهنگی اولیه — رزرو ابتدا PENDING_COORDINATION می‌ماند تا کارشناس/مدیر داخلی تاریخ نهایی را تأیید کند
  coordinationRespondedAt DateTime?

  serviceType      ServiceType       @relation(fields: [serviceTypeId], references: [id])
  contact          CrmContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  provider         User?             @relation("AppointmentProvider", fields: [providerUserId], references: [id], onDelete: SetNull)
  createdBy        User?             @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  mentoringSession MentoringSession?

  @@index([startAt])
  @@index([providerUserId, startAt])
  @@index([status])
  @@map("appointments")
}

/// وقت‌های آزاد هفتگی هر کارشناس — اگر کارشناسی هیچ اسلاتی تعریف نکرده باشد،
/// برای حفظ سازگاری با رفتار قبلی، «همیشه در دسترس» فرض می‌شود.
model StaffAvailabilitySlot {
  id          String @id @default(uuid())
  userId      String
  weekday     Int // 0=یکشنبه ... 6=شنبه
  startMinute Int // دقیقه از نیمه‌شب — مثلاً ۹:۰۰ = ۵۴۰
  endMinute   Int

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekday])
  @@map("staff_availability_slots")
}

// ── مدیریت قرارداد ───────────────────────────────────────────────────────
// امضای دیجیتال دوطرفه: هر قرارداد یک contentHash از متن نهایی نگه می‌دارد
// (نه رمزگذاری واقعی — چون هدف «غیرقابل‌تغییر بودن پس از امضا»ست، نه محرمانگی؛
// این دقیقاً همان الگوی واقعی امضای دیجیتال/DocuSign است: هش + رکورد امضا).
// پس از قفل‌شدن (isLocked)، هرگونه ویرایش فقط به شکل ContractAmendment جدید
// (خودش هم امضا و هش می‌شود) به قرارداد اصلی الحاق می‌شود، نه ویرایش مستقیم.

enum ContractType {
  SALES // قرارداد با مشتری
  PURCHASE // قرارداد با تأمین‌کننده
}

enum ContractPartyMode {
  INTERNAL // بین شرکت و پرسنل
  EXTERNAL // بین شرکت و مشتری/تأمین‌کننده
  THIRD_PARTY // بین دو طرف دیگر (که ممکن است هیچ‌کدام «ما» نباشیم)
}

enum ContractLegalCategory {
  NOTARIZED // ثبت‌شده در دفترخانه اسناد رسمی
  LAWYER_SUPERVISED // فقط تحت نظارت وکیل
  GENERAL // عمومی
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

model ContractTemplate {
  id              String            @id @default(uuid())
  name            String
  partyMode       ContractPartyMode @default(EXTERNAL)
  type            ContractType?
  body            String // متن پیش‌فرض بندها و شرایط
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  createdBy User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  contracts Contract[]

  @@map("contract_templates")
}

model Contract {
  id                   String                @id @default(uuid())
  contractNo           Int                   @unique @default(autoincrement())
  title                String
  type                 ContractType?
  partyMode            ContractPartyMode     @default(EXTERNAL)
  legalCategory        ContractLegalCategory @default(GENERAL)
  category             String? // دسته‌بندی آزاد کسب‌وکاری (مثلاً «اجاره»، «پیمانکاری»، «خدمات») — مستقل از legalCategory
  templateId           String?
  contactId            String? // طرف اول — مشتری/تأمین‌کننده (EXTERNAL) یا یکی از طرفین (THIRD_PARTY)
  employeeId           String? // طرف اول برای قرارداد داخلی (INTERNAL)
  secondPartyContactId String? // طرف دوم اگر خودش یکی از مخاطبین CRM باشد (THIRD_PARTY)
  secondPartyName      String? // طرف دوم آزاد — وقتی مخاطب ثبت‌شده‌ای نیست
  secondPartyPhone     String?
  status               ContractStatus        @default(DRAFT)
  value                Int // تومان — ارزش کل قرارداد
  startDate            DateTime
  endDate              DateTime
  autoRenew            Boolean               @default(false)
  renewalReminderDays  Int                   @default(30)
  reminderSentAt       DateTime?
  terms                String? // شرح بندها و شرایط قرارداد
  guaranteeTerms       String? // ضمانت اجرا — جریمه/وثیقه/تعهدات در صورت نقض قرارداد
  referredSignerUserId String? // اگر مشخص شود، امضای شرکت فقط توسط مالک/مدیر یا همین کاربر ممکن است
  signedAt             DateTime?
  terminatedAt         DateTime?
  terminationReason    String?
  createdByUserId      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  // امضای دیجیتال دوطرفه از طریق لینک عمومی + OTP
  publicToken            String    @unique @default(uuid())
  contentHash            String? // هش متن نهایی در لحظه‌ی تکمیل امضای هر دو طرف
  isLocked               Boolean   @default(false)
  partyASignedAt         DateTime?
  partyASignatureDataUrl String?
  partyASignerName       String?
  partyBSignedAt         DateTime?
  partyBSignatureDataUrl String?
  partyBSignerName       String?

  contact              CrmContact?           @relation(fields: [contactId], references: [id])
  employee             Employee?             @relation(fields: [employeeId], references: [id])
  secondPartyContact   CrmContact?           @relation("ContractSecondParty", fields: [secondPartyContactId], references: [id])
  template             ContractTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy            User?                 @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  referredSigner       User?                 @relation("ContractReferredSigner", fields: [referredSignerUserId], references: [id], onDelete: SetNull)
  editRequests         ContractEditRequest[]
  amendments           ContractAmendment[]
  witnesses            ContractWitness[]
  mentoringEngagements MentoringEngagement[]

  @@index([status])
  @@index([endDate])
  @@index([type])
  @@index([category])
  @@map("contracts")
}

/// شاهد قرارداد — امضای الکترونیک مستقل از طرفین اصلی، از طریق همان لینک عمومی قرارداد با OTP شماره‌ی خودش.
model ContractWitness {
  id               String    @id @default(uuid())
  contractId       String
  name             String
  phone            String
  signedAt         DateTime?
  signatureDataUrl String?
  createdAt        DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_witnesses")
}

enum ContractPartySide {
  PARTY_A
  PARTY_B
}

model ContractEditRequest {
  id         String            @id @default(uuid())
  contractId String
  side       ContractPartySide
  text       String
  resolved   Boolean           @default(false)
  createdAt  DateTime          @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_edit_requests")
}

// هر پیوست به‌عنوان یک نسخه‌ی امضاشده‌ی جداگانه — پس از امضای هر دو طرف، خودش
// هم قفل و هش می‌شود و در قرارداد اصلی به‌عنوان «در تاریخ فلان الحاق شد» ثبت می‌ماند.
model ContractAmendment {
  id                     String    @id @default(uuid())
  contractId             String
  text                   String
  contentHash            String?
  isLocked               Boolean   @default(false)
  partyASignedAt         DateTime?
  partyASignatureDataUrl String?
  partyBSignedAt         DateTime?
  partyBSignatureDataUrl String?
  createdByUserId        String?
  createdAt              DateTime  @default(now())

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@map("contract_amendments")
}

// ── مدیریت پروژه ─────────────────────────────────────────────────────────
// وظایف پروژه از سیستم Task عمومی همین کدبیس استفاده می‌کنند
// (relatedModule='project', relatedEntityId=Project.id) — یک موتور وظیفه‌ی
// موازی برای پروژه‌ها ساخته نمی‌شود. همین‌طور پیوست‌ها از مدل عمومی
// Attachment. این ماژول فقط ظرف پروژه و گردش وضعیتش را اضافه می‌کند.

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id                String        @id @default(uuid())
  projectNo         Int           @unique @default(autoincrement())
  name              String
  contactId         String?
  managerUserId     String?
  status            ProjectStatus @default(PLANNING)
  budget            Int? // تومان
  startDate         DateTime?
  endDate           DateTime?
  description       String?
  overdueNotifiedAt DateTime?
  createdByUserId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  contact              CrmContact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  manager              User?                 @relation("ProjectManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  createdBy            User?                 @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  stages               ProjectStage[]
  invoices             SalesInvoice[]
  members              ProjectMember[]
  mentoringEngagements MentoringEngagement[]

  @@index([status])
  @@index([endDate])
  @@map("projects")
}

/// عضو تیم اجرایی پروژه — جدا از مدیر پروژه (managerUserId)؛ چند نفر می‌توانند به یک پروژه اضافه شوند.
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

/// یک الگوی قابل‌استفاده‌ی مجدد برای مراحل پروژه (مثلاً «وب‌سایت استاندارد»:
/// تحلیل ← طراحی ← توسعه ← تست ← تحویل) — انتخابش موقع ساخت پروژه، مرحله‌های
/// واقعی (ProjectStage) را با همان ترتیب می‌سازد. حذف یک الگو مراحل پروژه‌های
/// قبلاً ساخته‌شده را دست نمی‌زند (آن‌ها رکورد مستقل خودشان را دارند).
model ProjectStageTemplate {
  id        String                     @id @default(uuid())
  name      String
  createdAt DateTime                   @default(now())
  items     ProjectStageTemplateItem[]

  @@map("project_stage_templates")
}

model ProjectStageTemplateItem {
  id         String @id @default(uuid())
  templateId String
  title      String
  order      Int

  template ProjectStageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("project_stage_template_items")
}

enum ProjectStageStatus {
  PENDING // هنوز شروع نشده
  AWAITING_APPROVAL // اجراکننده درخواست شروع داده، منتظر تأیید مدیر
  IN_PROGRESS // تأییدشده و در حال اجرا
  DONE
  REJECTED // مدیر درخواست شروع را رد کرده
}

model ProjectStage {
  id                String             @id @default(uuid())
  projectId         String
  title             String
  order             Int
  status            ProjectStageStatus @default(PENDING)
  responsibleUserId String? // مسئول اجرای این مرحله — گزارش تکمیل را همین فرد ثبت می‌کند
  requestedAt       DateTime?
  requestedByUserId String?
  approvedAt        DateTime?
  approvedByUserId  String?
  rejectionReason   String?
  completedAt       DateTime?
  completionReport  String? // یادداشت نتیجه‌ی مرحله — توسط مسئول مرحله هنگام تکمیل ثبت می‌شود
  createdAt         DateTime           @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible User?   @relation("ProjectStageResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  requestedBy User?   @relation("ProjectStageRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approvedBy  User?   @relation("ProjectStageApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("project_stages")
}

// ── ناوگان حمل و نقل (Fleet) ────────────────────────────────────────────
// راننده‌ها + ثبت بار (دستی/از حواله انبار/از فاکتور فروش) + الگوریتم تطبیق
// راننده مناسب + ارسال پیامکی پیشنهاد بار به‌ترتیب اولویت با فاصله‌ی ۵ دقیقه‌ای
// (توسط FleetOfferDispatchService، هر بار cron اجرا می‌شود) + پذیرش از طریق
// لینک عمومی بدون نیاز به OTP (اعتبار لینک، خودِ توکن یکتای غیرقابل‌حدس است —
// همان سطح امنیتی که برای این سناریوی عملیاتی کافی است). اسناد بار (بارنامه،
// قبض باسکول، برگ قرنطینه) از همان مدل عمومی Attachment استفاده می‌کنند
// (entityType="Shipment") — نیازی به مدل جدید نیست. نظرسنجی پس از تحویل هم
// همین‌جا و از همین ماژول کنترل می‌شود (نه یک ماژول نصب‌شدنی جدا).

model Driver {
  id                 String   @id @default(uuid())
  name               String
  phone              String
  vehicleType        String?
  plateNumber        String?
  capacityKg         Int? // ظرفیت بار — کیلوگرم
  serviceAreas       String[] // محدوده‌هایی که بار می‌برد
  availableHoursNote String? // یادداشت آزاد درباره‌ی ساعاتی که معمولاً در دسترس است
  reliabilityNote    String? // یادداشت درباره‌ی ویژگی‌های اخلاقی/اعتبار راننده
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  offers    ShipmentOffer[]
  shipments Shipment[]

  @@index([isActive])
  @@map("fleet_drivers")
}

enum ShipmentSourceType {
  MANUAL
  STOCK_MOVEMENT
  SALES_INVOICE
}

enum ShipmentStatus {
  DRAFT // ثبت شده، هنوز راننده‌ای پیشنهاد نشده
  OFFERED // پیشنهادها در حال ارسال/در انتظار پاسخ راننده‌ها
  ACCEPTED // یک راننده پذیرفته
  DELIVERED
  CANCELLED
}

model Shipment {
  id                    String             @id @default(uuid())
  shipmentNo            Int                @unique @default(autoincrement())
  sourceType            ShipmentSourceType @default(MANUAL)
  sourceStockMovementId String?
  sourceInvoiceId       String?
  contactId             String?
  cargoType             String
  quantity              Int
  unit                  String?
  deliveryAddress       String
  region                String? // برای تطبیق با محدوده‌ی سرویس‌دهی راننده‌ها
  pickupAt              DateTime
  status                ShipmentStatus     @default(DRAFT)
  driverId              String?
  acceptedAt            DateTime?
  deliveredAt           DateTime?
  createdByUserId       String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  contact   CrmContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  driver    Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  createdBy User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  offers    ShipmentOffer[]
  survey    DeliverySurvey?

  @@index([status])
  @@index([createdAt])
  @@map("fleet_shipments")
}

enum ShipmentOfferStatus {
  SCHEDULED // هنوز پیامک ارسال نشده — نوبتش طبق ترتیب و فاصله‌ی ۵ دقیقه‌ای می‌رسد
  PENDING // پیامک ارسال شد، منتظر پاسخ راننده
  ACCEPTED
  EXPIRED // راننده‌ی دیگری این بار را پذیرفت
}

model ShipmentOffer {
  id          String              @id @default(uuid())
  shipmentId  String
  driverId    String
  rank        Int // ترتیب اولویت طبق الگوریتم تطبیق — کوچک‌تر یعنی مناسب‌تر
  status      ShipmentOfferStatus @default(SCHEDULED)
  publicToken String              @unique @default(uuid())
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime            @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  driver   Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([status])
  @@map("fleet_shipment_offers")
}

model DeliverySurvey {
  id            String    @id @default(uuid())
  shipmentId    String    @unique
  publicToken   String    @unique @default(uuid())
  driverRating  Int? // ۱ تا ۵
  productRating Int? // ۱ تا ۵
  note          String?
  sentAt        DateTime?
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("fleet_delivery_surveys")
}

// ── منتورینگ، مشاوره و کوچینگ ───────────────────────────────────────────
// یک MentoringEngagement همان «مدل همکاری» بین مشاور/مربی داخلی (User) و
// مخاطب CRM است — تعرفه (ساعتی/بسته‌ای/پروژه‌ای/اشتراکی) و اتصال اختیاری
// به قرارداد رسمی (Contract) و پروژه (Project) روی همین رکورد می‌نشیند.
// هر جلسه (MentoringSession) یا از ماژول نوبت‌دهی رزرو شده (appointmentId)
// یا دستی ثبت می‌شود — زمان/شکل برگزاری همیشه مستقل و کامل روی خود جلسه
// نگه داشته می‌شود، دقیقاً مثل customerName مستقل از contactId در Appointment.

enum MentoringPricingModel {
  HOURLY // ساعتی
  PACKAGE // بسته‌ای — تعداد جلسه‌ی مشخص با قیمت ثابت
  PROJECT_BASED // پروژه‌ای — یک‌جا
  SUBSCRIPTION // اشتراک ماهانه
}

enum MentoringEngagementStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model MentoringEngagement {
  id                       String                    @id @default(uuid())
  engagementNo             Int                       @unique @default(autoincrement())
  contactId                String
  advisorUserId            String
  title                    String
  pricingModel             MentoringPricingModel     @default(HOURLY)
  hourlyRate               Int? // تومان
  packageSessionsCount     Int?
  packagePrice             Int?
  subscriptionMonthlyPrice Int?
  status                   MentoringEngagementStatus @default(ACTIVE)
  contractId               String?
  projectId                String?
  startDate                DateTime                  @default(now())
  endDate                  DateTime?
  notes                    String?
  createdByUserId          String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  contact   CrmContact         @relation(fields: [contactId], references: [id])
  advisor   User               @relation("MentoringAdvisor", fields: [advisorUserId], references: [id])
  contract  Contract?          @relation(fields: [contractId], references: [id], onDelete: SetNull)
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?              @relation("MentoringEngagementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  sessions  MentoringSession[]
  goals     MentoringGoal[]

  @@index([contactId])
  @@index([advisorUserId])
  @@index([status])
  @@map("mentoring_engagements")
}

enum MentoringSessionMode {
  ONLINE
  PHONE
  IN_PERSON
}

enum MentoringSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model MentoringSession {
  id              String                 @id @default(uuid())
  engagementId    String
  appointmentId   String?                @unique // اگر از ماژول نوبت‌دهی رزرو شده
  mode            MentoringSessionMode   @default(ONLINE)
  scheduledAt     DateTime
  durationMinutes Int                    @default(60)
  status          MentoringSessionStatus @default(SCHEDULED)
  location        String? // آدرس حضوری یا لینک آنلاین
  minutesNote     String? // صورتجلسه
  invoiceId       String?
  reminderSentAt  DateTime?
  surveySentAt    DateTime?
  createdByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  engagement   MentoringEngagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  appointment  Appointment?            @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  invoice      SalesInvoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy    User?                   @relation("MentoringSessionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  survey       MentoringSessionSurvey?
  goalCheckIns MentoringGoalCheckIn[]

  @@index([engagementId])
  @@index([scheduledAt])
  @@index([status])
  @@map("mentoring_sessions")
}

/// نظرسنجی پس از جلسه — همان الگوی DeliverySurvey (لینک عمومی + پیامک، بدون نیاز به ورود).
model MentoringSessionSurvey {
  id          String    @id @default(uuid())
  sessionId   String    @unique
  publicToken String    @unique @default(uuid())
  rating      Int? // ۱ تا ۵
  note        String?
  sentAt      DateTime?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  session MentoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("mentoring_session_surveys")
}

enum MentoringGoalType {
  QUANTITATIVE
  QUALITATIVE
}

enum MentoringGoalStatus {
  IN_PROGRESS
  ACHIEVED
  MISSED
  CANCELLED
}

/// هدف کمی یا کیفی تعریف‌شده برای یک قرارداد همکاری — پیشرفت با MentoringGoalCheckIn سنجیده می‌شود.
model MentoringGoal {
  id            String              @id @default(uuid())
  engagementId  String
  title         String
  type          MentoringGoalType   @default(QUALITATIVE)
  unit          String? // مثلاً «کیلوگرم»، «میلیون تومان فروش»
  baselineValue Float?
  targetValue   Float?
  targetDate    DateTime?
  status        MentoringGoalStatus @default(IN_PROGRESS)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  engagement MentoringEngagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  checkIns   MentoringGoalCheckIn[]

  @@index([engagementId])
  @@map("mentoring_goals")
}

/// ثبت پیشرفت دوره‌ای یک هدف — برای اهداف کمی value عدد است، برای کیفی فقط note.
model MentoringGoalCheckIn {
  id         String   @id @default(uuid())
  goalId     String
  sessionId  String?
  value      Float?
  note       String?
  recordedAt DateTime @default(now())

  goal    MentoringGoal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  session MentoringSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([goalId])
  @@map("mentoring_goal_check_ins")
}

// ── فروشگاه آنلاین ───────────────────────────────────────────────────────
// ماژول نصبی جدا: نمای عمومی (بدون نیاز به ورود) کالاهای isPubliclyListed
// را نشان می‌دهد، سفارش ثبت می‌کند (بدون درگاه پرداخت — فقط ثبت سفارش،
// طبق تصمیم صریح صاحب محصول)، و موجودی مرتبط را رزرو می‌کند تا فروش بیش
// از ظرفیت واقعی انبار رخ ندهد. رویدادهای تحلیلی (بازدید/مکث/افزودن به
// سبد) با یک sessionToken سمت کلاینت (بدون نیاز به ورود کاربر) ثبت می‌شوند.

enum StoreOrderStatus {
  PENDING // تازه ثبت شده — موجودی رزرو شده، هنوز تأیید نشده
  CONFIRMED // تننت سفارش را تأیید کرد
  PACKED // بسته‌بندی شد
  SHIPPED // ارسال شد — رزرو به کسر واقعی موجودی (StockMovement) تبدیل می‌شود
  DELIVERED
  CANCELLED // رزرو موجودی آزاد می‌شود
}

model StoreOrder {
  id              String           @id @default(uuid())
  orderNo         Int              @unique @default(autoincrement())
  contactId       String?
  customerName    String
  customerPhone   String
  shippingAddress String
  notes           String?
  status          StoreOrderStatus @default(PENDING)
  subtotal        Int // تومان — مجموع خطوط، در لحظه‌ی ثبت
  trackingCode    String?
  sessionToken    String? // برای اتصال این سفارش به رویدادهای تحلیلی همان بازدیدکننده
  createdAt       DateTime         @default(now())
  confirmedAt     DateTime?
  packedAt        DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  contact CrmContact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lines   StoreOrderLine[]

  @@index([status])
  @@index([createdAt])
  @@index([contactId])
  @@map("store_orders")
}

model StoreOrderLine {
  id          String @id @default(uuid())
  orderId     String
  productId   String // بدون رابطه‌ی FK عمدی — حتی اگر بعداً کالا حذف/تغییر کرد، این خط تاریخی دست‌نخورده می‌ماند
  productName String // اسنپ‌شات نام کالا در لحظه‌ی سفارش
  quantity    Int
  unitPrice   Int // تومان — اسنپ‌شات قیمت در لحظه‌ی سفارش
  lineTotal   Int

  order StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("store_order_lines")
}

enum StoreAnalyticsEventType {
  PAGE_VIEW // باز شدن صفحه‌ی اصلی فروشگاه
  PRODUCT_VIEW // باز شدن صفحه‌ی یک کالا
  PRODUCT_DWELL // مدت‌زمان ماندن روی صفحه‌ی کالا (ثانیه، در meta)، هنگام ترک صفحه ارسال می‌شود
  ADD_TO_CART
  ORDER_PLACED
}

model StoreAnalyticsEvent {
  id           String                  @id @default(uuid())
  sessionToken String
  type         StoreAnalyticsEventType
  productId    String? // بدون رابطه‌ی FK عمدی — همان دلیل StoreOrderLine
  meta         Json?
  occurredAt   DateTime                @default(now())

  @@index([type, occurredAt])
  @@index([sessionToken])
  @@index([productId])
  @@map("store_analytics_events")
}

enum StoreReviewStatus {
  PENDING // پیش از تأیید تننت در فروشگاه عمومی نمایش داده نمی‌شود
  APPROVED
  REJECTED
}

model StoreReview {
  id           String            @id @default(uuid())
  productId    String
  customerName String
  rating       Int // ۱ تا ۵
  comment      String?
  status       StoreReviewStatus @default(PENDING)
  createdAt    DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([status])
  @@map("store_reviews")
}

// ── Marketing: کمپین‌های بازاریابی چندکاناله (پیامک/بله/واتساپ/تمپلیت اینستاگرام) ──

enum MarketingChannel {
  SMS
  BALE // ربات بله — ارسال واقعی نیازمند chat_id مخاطب است که فعلاً ثبت نمی‌شود
  WHATSAPP // نیازمند WhatsApp Business API — فعلاً پیاده‌سازی نشده
  INSTAGRAM_TEMPLATE // ارسال واقعی ندارد؛ فقط تصویر پست/استوری برای انتشار دستی می‌سازد
}

enum MarketingCampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum MarketingRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // کانال برای این مخاطب قابل استفاده نبود (مثلاً بدون شماره موبایل)
}

model MarketingCampaign {
  id              String                  @id @default(uuid())
  name            String
  channel         MarketingChannel
  status          MarketingCampaignStatus @default(DRAFT)
  messageText     String? // متن پیام برای SMS/BALE/WHATSAPP
  templateCode    String? // کد قالب برای INSTAGRAM_TEMPLATE (post-square, story)
  templateTitle   String? // عنوان روی تصویر تمپلیت
  templateCta     String? // متن دکمه/فراخوان‌به‌اقدام روی تصویر تمپلیت
  audienceFilter  Json // معیار فیلتر مخاطبین هنگام ساخت کمپین — برای بازتولید/شفافیت نگه داشته می‌شود
  createdByUserId String?
  createdAt       DateTime                @default(now())
  sentAt          DateTime?

  recipientCount       Int @default(0)
  sentCount            Int @default(0)
  failedCount          Int @default(0)
  // عملکرد کمپین: چند نفر از گیرندگان طی ۷ روز بعد از ارسال خرید ثبت کردند —
  // تخمین اثر کمپین، نه اسناد رسمی attribution.
  attributedOrderCount Int @default(0)
  attributedRevenue    Int @default(0) // تومان

  createdByUser User?                        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients    MarketingCampaignRecipient[]

  @@index([status])
  @@index([createdAt])
  @@map("marketing_campaigns")
}

model MarketingCampaignRecipient {
  id         String                   @id @default(uuid())
  campaignId String
  contactId  String
  phone      String? // اسنپ‌شات شماره در لحظه‌ی ارسال
  status     MarketingRecipientStatus @default(PENDING)
  error      String?
  sentAt     DateTime?

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  CrmContact        @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([contactId])
  @@map("marketing_campaign_recipients")
}

// ── رویداد و بلیط‌فروشی ──────────────────────────────────────────────────
// یک صفحه‌ی عمومی قابل سئو (لیست + جزئیات رویداد، مثل فروشگاه آنلاین) که
// بازدیدکننده بدون ورود، بلیط رزرو و پرداخت آنلاین می‌کند؛ شماره‌اش با پیامک
// OTP تأیید می‌شود (همان الگوی JWT کوتاه‌مدت PublicBookingService — چون پول
// واقعی رد و بدل می‌شود، نه فقط رزرو وقت رایگان). بعد از پرداخت موفق (یا
// فوری برای بلیط رایگان)، یک CrmContact بر اساس شماره خریدار پیدا/ساخته
// می‌شود تا فاکتور واقعی از طریق InvoicesService صادر شود — تنها ماژول
// عمومی این کدبیس که عمداً از الگوی «بدون ساخت مخاطب» بقیه‌ی فلوهای عمومی
// (نوبت‌دهی، فروشگاه) فاصله می‌گیرد، چون اینجا صدور فاکتور واقعی لازم است.
// هر شرکت‌کننده یک EventTicket مستقل با qrToken خودش می‌گیرد تا حضور هرکدام
// جدا در ورودی اسکن شود، حتی اگر چند بلیط با یک خرید ثبت شده باشند.

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventBookingStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
}

enum EventTicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
}

model Event {
  id                   String      @id @default(uuid())
  eventNo              Int         @unique @default(autoincrement())
  slug                 String      @unique
  title                String
  description          String?
  coverImage           String? // data URI — همان الگوی Product.publicImages، بدون فضای ذخیره‌سازی فایل جداگانه
  venue                String? // آدرس حضوری
  isOnline             Boolean     @default(false)
  onlineUrl            String? // لینک برگزاری آنلاین — فقط بعد از تکمیل ثبت‌نام/پرداخت روی بلیط نمایش داده می‌شود
  startAt              DateTime
  endAt                DateTime
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  capacity             Int? // ظرفیت کل — سقف جمع ظرفیت‌های انواع بلیط؛ خالی یعنی نامحدود
  category             String?
  status               EventStatus @default(DRAFT)
  createdByUserId      String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  createdBy   User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  ticketTypes EventTicketType[]
  bookings    EventBooking[]
  tickets     EventTicket[]

  @@index([status])
  @@index([startAt])
  @@map("events")
}

model EventTicketType {
  id        String   @id @default(uuid())
  eventId   String
  name      String // مثلاً «عادی»، «VIP»
  price     Int      @default(0) // تومان — صفر یعنی رایگان
  capacity  Int? // خالی یعنی فقط سقف کلی رویداد اعمال می‌شود
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings EventBooking[]
  tickets  EventTicket[]

  @@index([eventId])
  @@map("event_ticket_types")
}

model EventBooking {
  id                String             @id @default(uuid())
  bookingNo         Int                @unique @default(autoincrement())
  orderGroupId      String             @default(uuid()) // چند نوع بلیط در یک خرید (مثلاً عادی+ویژه) همین مقدار مشترک را دارند — پرداخت و صدور فاکتور روی کل گروه انجام می‌شود
  eventId           String
  ticketTypeId      String
  buyerName         String
  buyerPhone        String
  contactId         String? // بعد از پرداخت موفق پر می‌شود (پیدا/ساخته‌شده بر اساس شماره خریدار)
  quantity          Int
  unitPrice         Int
  totalAmount       Int
  status            EventBookingStatus @default(PENDING_PAYMENT)
  publicToken       String             @unique @default(uuid())
  zarinpalAuthority String?
  paymentRefId      Int?
  paidAt            DateTime?
  invoiceId         String?
  createdAt         DateTime           @default(now())

  event      Event           @relation(fields: [eventId], references: [id])
  ticketType EventTicketType @relation(fields: [ticketTypeId], references: [id])
  contact    CrmContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  invoice    SalesInvoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  tickets    EventTicket[]

  @@index([eventId])
  @@index([status])
  @@index([orderGroupId])
  @@map("event_bookings")
}

model EventTicket {
  id                String            @id @default(uuid())
  bookingId         String
  eventId           String
  ticketTypeId      String
  ticketCode        String            @unique // کد کوتاه انسان‌خوان — روی بلیط چاپی/پیامکی
  qrToken           String            @unique @default(uuid()) // محتوای واقعی QR — اسکن با همین مقدار تطبیق داده می‌شود
  attendeeName      String
  attendeePhone     String?
  status            EventTicketStatus @default(VALID)
  checkedInAt       DateTime?
  checkedInByUserId String?
  createdAt         DateTime          @default(now())

  booking     EventBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event       Event           @relation(fields: [eventId], references: [id])
  ticketType  EventTicketType @relation(fields: [ticketTypeId], references: [id])
  checkedInBy User?           @relation("EventTicketCheckedInBy", fields: [checkedInByUserId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([eventId])
  @@index([status])
  @@map("event_tickets")
}

// ── فرم‌ساز — نظرسنجی، آزمون آنلاین، پرسش‌نامه، ثبت‌نام ─────────────────────
// یک فرم عمومی قابل اشتراک‌گذاری با لینک (embed در سایت خودِ تننت هم ممکن
// است — این اپ هیچ هدر X-Frame-Options/CSP محدودکننده‌ای ست نمی‌کند)، بدون
// نیاز به ورود کاربر پاسخ‌دهنده. اگر شماره تماس گرفته شود، پاسخ‌دهنده مثل
// بقیه‌ی ماژول‌های عمومی (رویداد، مشاوره) با همان شماره به یک CrmContact
// موجود/جدید متصل می‌شود — این همان هویت مشترک بر اساس شماره است.
// برای حالت «آزمون آنلاین»، هر سؤال تک‌گزینه‌ای می‌تواند یک گزینه‌ی درست و
// امتیاز داشته باشد؛ نمره و قبولی در لحظه‌ی ثبت محاسبه می‌شود.

enum FormType {
  SURVEY // نظرسنجی
  QUIZ // آزمون آنلاین
  QUESTIONNAIRE // پرسش‌نامه
  REGISTRATION // فرم ثبت‌نام
}

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  SINGLE_CHOICE
  MULTI_CHOICE
  RATING // ۱ تا ۵
  DATE
  PHONE
  EMAIL
}

model Form {
  id               String     @id @default(uuid())
  formNo           Int        @unique @default(autoincrement())
  slug             String     @unique
  type             FormType   @default(QUESTIONNAIRE)
  title            String
  description      String?
  coverImage       String? // data URI — همان الگوی Event.coverImage
  status           FormStatus @default(DRAFT)
  collectPhone     Boolean    @default(true) // شماره تماس پاسخ‌دهنده گرفته شود؟
  requirePhone     Boolean    @default(false)
  createContact    Boolean    @default(false) // هر پاسخ یک CrmContact بسازد/به‌روزرسانی کند — پیش‌فرض فرم ثبت‌نام
  closesAt         DateTime?
  passScorePercent Int? // فقط برای QUIZ — درصد قبولی
  thankYouMessage  String?
  createdByUserId  String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  createdBy   User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  fields      FormField[]
  submissions FormSubmission[]

  @@index([status])
  @@map("forms")
}

model FormField {
  id            String        @id @default(uuid())
  formId        String
  type          FormFieldType
  label         String
  helpText      String?
  required      Boolean       @default(false)
  sortOrder     Int           @default(0)
  options       String[]      @default([]) // برای SINGLE_CHOICE/MULTI_CHOICE
  correctOption String? // فقط برای QUIZ
  points        Int? // فقط برای QUIZ

  form    Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers FormAnswer[]

  @@index([formId])
  @@map("form_fields")
}

model FormSubmission {
  id              String   @id @default(uuid())
  formId          String
  contactId       String?
  respondentName  String?
  respondentPhone String?
  scorePercent    Float? // فقط برای QUIZ
  passed          Boolean? // فقط برای QUIZ
  submittedAt     DateTime @default(now())

  form    Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact CrmContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  answers FormAnswer[]

  @@index([formId])
  @@index([contactId])
  @@map("form_submissions")
}

model FormAnswer {
  id           String   @id @default(uuid())
  submissionId String
  fieldId      String
  valueText    String? // پاسخ متنی/عدد/تاریخ/گزینه‌ی تکی
  valueOptions String[] @default([]) // برای MULTI_CHOICE

  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field      FormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([fieldId])
  @@map("form_answers")
}

// ── گارانتی و خدمات پس از فروش ──────────────────────────────────────────────
// یک کد گارانتی یکتا و کاملاً تصادفی (بدون هیچ الگوی قابل‌حدس‌زدن) به ازای هر
// واحد از یک کالای مشمول گارانتی صادر می‌شود — خودکار وقتی فاکتور فروش کامل
// تسویه می‌شود (SalesInvoice.status -> PAID)، یا دستی از فاکتور/بدون فاکتور.
// مشتری با فرم عمومی (بدون ورود، بر اساس شماره تماس — همان هویت مشترک
// CrmContact این سیستم) گارانتی خود را فعال و در صورت نیاز درخواست خدمات
// پس از فروش ثبت می‌کند.

enum WarrantyCodeStatus {
  PENDING // صادرشده، هنوز توسط مشتری فعال نشده
  ACTIVE
  EXPIRED
  VOID
}

enum WarrantyServiceStatus {
  NEW
  REVIEWING
  AWAITING_PRODUCT // در انتظار ارسال کالا توسط مشتری
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model WarrantyCode {
  id                  String             @id @default(uuid())
  code                String             @unique // ۱۰ کاراکتر تصادفی، حروف بزرگ+عدد (بدون 0،1،I،O،L)
  productId           String?
  itemDescription     String? // برای صدور دستی بدون کالای کاتالوگ، یا اسنپ‌شات عنوان در لحظه‌ی صدور
  invoiceId           String?
  invoiceLineId       String? // ردیف مشخص فاکتور — کلید جلوگیری از صدور دوباره برای همان ردیف
  manualInvoiceNumber String? // شماره فاکتور خارج از سیستم (صدور کاملاً دستی)
  contactId           String?
  serialNumber        String?
  durationDays        Int                @default(365)
  status              WarrantyCodeStatus @default(PENDING)
  issuedAt            DateTime           @default(now())
  activatedAt         DateTime?
  expiresAt           DateTime?
  activatedByName     String?
  activatedByPhone    String?
  activatedByEmail    String?
  termsAcceptedAt     DateTime?
  productPhoto        String? // data URI — عکس محصول ارسالی مشتری هنگام فعال‌سازی
  createdByUserId     String?
  createdAt           DateTime           @default(now())

  product        Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  invoice        SalesInvoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceLine    SalesInvoiceLine?        @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  contact        CrmContact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy      User?                    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  services       WarrantyServiceRequest[]
  activationLogs WarrantyActivationLog[]

  @@index([status])
  @@index([contactId])
  @@index([invoiceId])
  @@index([invoiceLineId])
  @@map("warranty_codes")
}

model WarrantyServiceRequest {
  id               String                @id @default(uuid())
  warrantyId       String
  description      String
  photo            String? // data URI
  status           WarrantyServiceStatus @default(NEW)
  staffNotes       String?
  customerRating   Int? // ۱ تا ۵
  customerFeedback String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  resolvedAt       DateTime?

  warranty WarrantyCode @relation(fields: [warrantyId], references: [id], onDelete: Cascade)

  @@index([warrantyId])
  @@index([status])
  @@map("warranty_service_requests")
}

/// لاگ تلاش‌های استعلام/فعال‌سازی عمومی — برای rate limit و ردگیری امنیتی
model WarrantyActivationLog {
  id         String   @id @default(uuid())
  warrantyId String?
  codeTried  String?
  ipAddress  String?
  userAgent  String?
  action     String // lookup | activate | request_service
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())

  warranty WarrantyCode? @relation(fields: [warrantyId], references: [id], onDelete: SetNull)

  @@index([ipAddress])
  @@index([warrantyId])
  @@map("warranty_activation_logs")
}
