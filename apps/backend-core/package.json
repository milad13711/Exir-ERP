  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:control:generate": "prisma generate --schema prisma/control/schema.prisma",
    "prisma:control:migrate": "prisma migrate dev --schema prisma/control/schema.prisma",
    "prisma:control:deploy": "prisma migrate deploy --schema prisma/control/schema.prisma",
    "prisma:tenant:generate": "prisma generate --schema prisma/tenant/schema.prisma",
    "seed": "tsx prisma/control/seed.ts",
    "license:keygen": "tsx scripts/generate-license-keypair.ts",
    "bootstrap:on-premise": "node dist/scripts/bootstrap-on-premise.js"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
