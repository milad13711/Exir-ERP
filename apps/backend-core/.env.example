# Local development environment — do not use these values in production.

PORT=3001

# Control Plane (shared database: tenants, billing, module catalog, staff, tickets)
CONTROL_DATABASE_URL="postgresql://postgres@127.0.0.1:5433/exir_control?schema=public"

# Base connection info used to provision a new tenant database on the shared cluster.
# (Dedicated on-premise tenants override this per-tenant, stored on the Tenant row.)
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5433
TENANT_DB_ADMIN_USER=postgres

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN_SECONDS=604800

# OTP is mocked in dev: the code is echoed back in the API response instead of
# being sent over SMS, so the flow can be tested without a real SMS provider.
# Ignored automatically once a real SMS was actually sent (see below).
OTP_DEV_ECHO=true

# اکسیر پیامک (exirsms.ir, نماینده‌ی لیمو پیامک) — ارسال واقعی کد ورود.
# خالی بماند تا از OTP_DEV_ECHO بالا استفاده شود.
EXIR_SMS_API_KEY=
EXIR_SMS_SENDER_LINE=
# فقط در صورت نیاز به تغییر آدرس درگاه تنظیم شود؛ پیش‌فرض api.limosms.com
EXIR_SMS_API_BASE_URL=

# آدرس‌های مجاز CORS، جدا شده با کاما. پنل تننت (وب‌پنل) و پنل مدیریت
# (admin-panel) هر دو باید اینجا باشند وقتی هر دو محلی اجرا می‌شوند.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ── Security (see docs/security/audit-2026-10.md) ────────────────────────────
# JWT_SECRET above is a dev placeholder; boot refuses missing/placeholder/very weak secrets. Use `openssl rand -hex 32` in production.
# AES-256-GCM key (64 hex) for secrets at rest (payment gateway / SMS panel keys, 2FA secrets). Empty => saving them is refused.
APP_SECRETS_KEY=
# ADMIN_REQUIRE_TOTP=true            # force TOTP 2FA for every admin-panel user
# TENANT_REQUIRE_2FA_FOR_ADMINS=grace # tenant OWNER/ADMIN 2FA: off | grace (default) | enforce; per-tenant override in admin panel
# TENANT_2FA_GRACE_DAYS=14           # grace length, counted from each admin's first sighting after the feature ships
# ADMIN_JWT_EXPIRES_IN_SECONDS=43200 # admin console token lifetime
# LOGIN_OTP_DIGITS=4                 # 4 (default) or 6
# OTP_GLOBAL_DAILY_CAP=20000         # global OTP/day cap (SMS-pumping guard)
# RATE_LIMIT_REPORT_ONLY=true        # log-only rate limiting (rollout); RATE_LIMIT_DISABLED=true is an emergency off switch
# RL_OTP_REQUEST_PER_IP_15M=30  RL_OTP_VERIFY_PER_IP_15M=60  RL_OTP_VERIFY_PER_PHONE_15M=12  RL_ADMIN_LOGIN_PER_IP_15M=20
# RL_PUBLIC_WRITE_PER_IP_MIN=120  RL_PUBLIC_READ_PER_IP_MIN=600  RL_GENERIC_PER_IP_MIN=3000  RL_TOKEN_PER_MIN=1500  RL_SIGNUP_PER_IP_HOUR=10
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=true # allow tenant webhooks to LAN targets (default blocks private/metadata ranges)
# SWAGGER_ENABLED=false              # hide /api/docs
# PUBLIC_BODY_LIMIT_BYTES=8388608    # body cap for unauthenticated /api/public routes
# SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD  # production-only first super-admin (default admin@exir.co is DEV only)
# (obsolete) ADMIN_ALLOW_DEFAULT_PASSWORDS: a repo-default admin password now logs in as a restricted session that must change the password at /account
